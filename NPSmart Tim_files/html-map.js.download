            cards_menu_left += createHtmlLeftMenu(element, mapInstancy)
        });
        tab_menu_left += '</div>';
        cards_menu_left += '</div>'
        html_menu = `
        <div class = 'map-cells-card-files-subtitles'>

        </div>
