        <div value ='trimFields' class ='map-cells-record-fields-set'>
            <div>
                <input type="checkbox" checked/>
                <span>Trim fields </span>
            </div>
        </div>

    `

    let geometryDefinitionOptions = `
        <label>
            <input type="checkbox" checked='true' name="fileFormatOption" value="pointCoordinates">
            Point coordinates
        </label>
    
    `

    let geometryDefinitionOptionsContent = `
        <div value ='pointCoordinates' class ='map-cells-geometry-definition-set'>
            <div value ='x-field'>
                <span>X field</span>
                <select class='map-cells-geometry-definition-field' axis='x'>
                
                </select>
            </div>
            <div value ='y-field'>
                <span>Y field</span>
                <select class='map-cells-geometry-definition-field' axis='y'>
                
                </select>
            </div>
            <div value ='z-field'>
                <span>Z field</span>
                <select class='map-cells-geometry-definition-field' axis='z'>
                
                </select>
            </div>
        </div>
    `

    let mainContent = `
        <div class = 'map-cells-manage-input-areas'>
            <div class = 'map-cells-manage-input-layer'>
                <div class = 'map-cells-manage-input-layer-name'>
                    <span>Layer Name:</span>
                    <input value='${fileName}'></input>
                </div>
                <div class = 'map-cells-manage-input-layer-encoding'>
                    <span>Encoding</span>
                    <select>
                        ${encodingOptions}
                    </select>
                </div>
            </div>
            
        </div>
        <div class = 'map-cells-manage-file-format'>
            <div class ='map-cells-manage-file-format-title'>
                <span>
                    <b>File Format</b>
                    <img status ='open' class='map-cells-icon-manage' value ='file-format' src='/npsmart/images/icon-show-hide-arrow-management-menu.png'>
                </span>
            </div>
            <div class ='map-cells-manage-file-format-content'>
                <div class = 'map-cells-manage-file-format-options'>
                    ${fileFormatOptions}
                </div>
                <div class ='map-cells-manage-file-format-options-content'>
                    ${fileFormatOptionsContent}
                </div>
            </div>
        </div>

        <div class = 'map-cells-manage-record-fields'>
            <div class ='map-cells-manage-record-fields-title'>
                <span>
                    <b>Record and Fields Options</b>
                    <img status ='open' class='map-cells-icon-manage' value ='record-fields' src='/npsmart/images/icon-show-hide-arrow-management-menu.png'>
                </span>
            </div>
            <div class ='map-cells-manage-record-fields-content'>
                ${recordFieldsContent}
            </div>
            
        </div>

        <div class = 'map-cells-manage-geometry-definition'>
            <div class ='map-cells-manage-geometry-definition-title'>
                <span>
                    <b>Geometry Definition</b>
                    <img status ='open' class='map-cells-icon-manage' value ='geometry-definition' src='/npsmart/images/icon-show-hide-arrow-management-menu.png'>
                </span>
            </div>
            <div class ='map-cells-manage-geometry-definition-content'>
                <div class = 'map-cells-manage-geometry-definition-options'>
                    ${geometryDefinitionOptions}
                </div>
                <div  class ='map-cells-manage-geometry-definition-options-content'>
                    ${geometryDefinitionOptionsContent}
                </div>
            </div>
        </div>

        <div class = 'map-cells-manage-table-data-formated'>
            <table id="map-cells-manage-dinamic-table">
                <thead>
                    <tr id="map-cells-manage-table-thead"></tr>
                </thead>
                <tbody>
                
                </tbody>
            </table>
            
        </div>
        <div>
            <span style='color:black'>
                Datetime types will only be detected if they are in this format: YYYY/MM/DD HH:mm:ss[.sss], with milliseconds optional
            </span>
        </div>

    `



    divManageScreenLayer.innerHTML += `
            <div class = 'map-cells-close-manage-screen'> 
                    <span>Data Sorce Manager - NPGIS</span>
                    <img class = 'map-cells-close-manage-screen-icon' src="/npsmart/images/icon-close.png">
            </div>
            <div class = 'map-cells-main-manage-screen'>
                ${mainContent}
            </div>
            <div class='map-cells-confirmation-manage-screen'> 
                <button id='map-cells-confirmation-manage-cancel'>Cancel</button>
                <button id='map-cells-confirmation-manage-set'>Add</button>
            </div>
        `
    //Fechar a tela de criação de um novo layer
    document.querySelector('.map-cells-close-manage-screen-icon').addEventListener('click', function () {
        divManageScreenLayer.remove()
        document.querySelector('#map-cells-choose-file').value = ''
        blockUi(false, mapCellsInstancy)
    })

    document.querySelector('#map-cells-confirmation-manage-cancel').addEventListener('click', function () {
        divManageScreenLayer.remove()
        document.querySelector('#map-cells-choose-file').value = ''
        blockUi(false, mapCellsInstancy)
    })

    let recordFieldsValues = {}

    function getRecordFieldsValues() {
        document.querySelectorAll('.map-cells-record-fields-set').forEach(function (element) {
            element.querySelectorAll('input').forEach(function (input) {
                var fieldName = element.getAttribute('value');
                var value;

                if (input.type === 'checkbox') {
                    value = input.checked;
                } else if (input.type === 'number') {
                    value = input.value;
                } else {
                    value = input.value;
                }
                recordFieldsValues[fieldName] = value;
            })
        })
    }
    getRecordFieldsValues()
    let fileProcessed = processFile(mapCellsInstancy.files[fileName].slice(0, 100), [','], recordFieldsValues)

    let header = fileProcessed.header
    let dataTable = fileProcessed.jsonData


    document.querySelectorAll('.map-cells-record-fields-set').forEach(function (element) {
        element.querySelectorAll('input').forEach(function (input) {
            input.addEventListener('change', function () {

                getRecordFieldsValues()
                let jsonProcessed = processFile(mapCellsInstancy.files[fileName].slice(0, 100), fileFormatinputsValues, recordFieldsValues)
                setSelectOptionsGeometryDefinition(jsonProcessed.header)
                AttThead(jsonProcessed.header)
                addTableData(jsonProcessed.jsonData.slice(0, 5))
            })
        })
    })

    document.querySelectorAll('.map-cells-icon-manage').forEach(function (element) {
        element.addEventListener('click', function () {
            if (element.getAttribute('status') === 'open') {
                $(`.map-cells-manage-${element.getAttribute('value')}-content`).css({
                    'display': 'none'
                });
                $(this).css('transform', 'rotate(90deg)');
                element.setAttribute('status', 'close');
            } else {
                $(`.map-cells-manage-${element.getAttribute('value')}-content`).css({
                    'display': 'flex'
                });
                $(this).css('transform', 'rotate(-90deg)');
                element.setAttribute('status', 'open');
            }
        });
    });

    var options_input = document.querySelectorAll('.map-cells-manage-file-format-options input');

    var fileFormatinputsValues = [',']
    var dataInputChoice = ''

    var encondingValue = ''
    function getEncodingValue() {
        encondingValue = document.querySelector('.map-cells-manage-input-layer-encoding select').value
    }

    document.querySelector('.map-cells-manage-input-layer-encoding select').addEventListener('change', function () {
        getEncodingValue()
    })


    function AttThead(headers) {
        var theadRow = document.getElementById('map-cells-manage-table-thead');
        theadRow.innerHTML = '';

        headers.forEach(function (header) {
            var th = document.createElement('th');
            th.textContent = header;
            theadRow.appendChild(th);
        });
    }

    function addTableData(data) {
        var tbody = document.querySelector('#map-cells-manage-dinamic-table tbody');
        tbody.innerHTML = '';

        data.forEach(function (element) {
            var tr = document.createElement('tr');

            // Adicione células para cada dado
            Object.values(element).forEach(function (value) {
                var td = document.createElement('td');
                td.textContent = value;
                tr.appendChild(td);
            });

            tbody.appendChild(tr);
        });
    }

    function getFileFormatInputValues() {
        fileFormatinputsValues = []
        if (dataInputChoice != 'csv') {
            let fileFormatInputChoice = document.querySelector(`.map-cells-file-format-set[value="${dataInputChoice}"]`)
            fileFormatInputChoice.querySelectorAll('div input').forEach(element => {
                if (element.type == 'text' && element.value != '') {
                    fileFormatinputsValues.push(element.value)
                } else if (element.type == 'checkbox' && element.checked) {
                    let delimiterMap = {
                        'tab': '\t',
                        'colon': ':',
                        'space': ' ',
                        'semicolon': ';',
                        'comma': ','
                    };
                    fileFormatinputsValues.push(delimiterMap[element.value])
                }
            })
        } else {
            fileFormatinputsValues.push(',')
        }

        getRecordFieldsValues()
        let jsonProcessed = processFile(mapCellsInstancy.files[fileName].slice(0, 100), fileFormatinputsValues, recordFieldsValues)
        setSelectOptionsGeometryDefinition(jsonProcessed.header)
        AttThead(jsonProcessed.header)
        addTableData(jsonProcessed.jsonData.slice(0, 5))
    }

    options_input.forEach(option => {
        option.addEventListener('change', function (e) {
            options_input.forEach(input => {
                if (input !== e.target) {
                    input.checked = false;
                    document.querySelectorAll('.map-cells-file-format-set').forEach(element => {
                        element.style.display = 'none'
                        if (element.getAttribute('value') == e.target.value) {
                            element.style.display = 'grid'
                        }

                    })
                }
            });

            dataInputChoice = e.target.value
            getFileFormatInputValues()

        });
    });

    function setSelectOptionsGeometryDefinition(header) {
        let optionsGeometryDefinitionFields = ''
        header.forEach(element => {
            optionsGeometryDefinitionFields += `
                <option value='${element}'>${element}</option>
            `
        })



        let selectsGeometryDefinition = document.querySelectorAll('.map-cells-geometry-definition-field')
        selectsGeometryDefinition.forEach(element => {
            element.innerHTML = optionsGeometryDefinitionFields
            let findValue = ''
            if (element.getAttribute('axis') == 'x') {
                findValue = 'lon'
            }
            if (element.getAttribute('axis') == 'y') {
                findValue = 'lat'
            }
            if (element.getAttribute('axis') == 'z') {
                findValue = 'azi'
            }
            for (let value of header) {
                // Transforma o elemento para minúsculas e verifica se contém "lat"
                if (value.toLowerCase().includes(findValue)) {
                    element.value = value
                    break
                } else {
                    element.value = ''
                }
            }

        })

    }

    setSelectOptionsGeometryDefinition(header)
    AttThead(header)
    addTableData(dataTable.slice(0, 5))


    let fileFormatInputs = document.querySelectorAll('.map-cells-file-format-set div input')

    fileFormatInputs.forEach(element => {
        element.addEventListener('change', function () {
            getFileFormatInputValues()
        })
        element.addEventListener('input', function () {
            getFileFormatInputValues()
        })
    })



    document.querySelector('#map-cells-confirmation-manage-set').addEventListener('click', function () {
        console.log('click #map-cells-confirmation-manage-set')

        $('.map-cells-loading-upload').css('opacity','1')

        let jsonProcessed = processFile(mapCellsInstancy.files[fileName], fileFormatinputsValues, recordFieldsValues)


        let layerName = document.querySelector('.map-cells-manage-input-layer-name input').value
        layerName = layerName.replace(/\s+/g, '');
        let fileinput = document.querySelector('#map-cells-choose-file').files[0]
        let info = {}
        let geometryDefinitionSelects = document.querySelectorAll(`.map-cells-geometry-definition-set div select`)
        geometryDefinitionSelects.forEach(element => {
            info[element.getAttribute('axis')] = element.value
        })
        info.layerName = layerName

        function uploadFile(fileSelected, newFileName, fileFormatinputsValues, encondingValue, header, info, recordFieldsValues) {
            console.log('LINHA 1109')
            console.log(info, header)

            Object.entries(header).forEach((e) => {
                if(!e[1]) {
                    header[e[0]] = 'TEXT'
                }
            })

            const formData = new FormData();
            const newFile = new File([fileSelected], newFileName, { type: fileSelected.type });
            formData.append('file', newFile);
            formData.append('format', JSON.stringify(fileFormatinputsValues));
            formData.append('encoding', encondingValue);
            formData.append('header', JSON.stringify(header));
            formData.append('recordFields', JSON.stringify(recordFieldsValues))
            fetch('/npsmart/map/saveFile', {
                method: 'POST',
                body: formData,
            })
                .then(response => response.json())
                .then(data => {
                    console.log(data)
                    $('.map-cells-loading-upload').css('opacity','0')
                    blockUi(false, mapCellsInstancy)
                    mapCellsInstancy.files[data] = {}
                    mapCellsInstancy.files[data].info = info
                    mapCellsInstancy.files[data].info.color = colorHexa()
                    mapCellsInstancy.files[data].info.headerTypes = header
                    mapCellsInstancy.files[data].info.request = 0

                    info.layer = 'newLayer'
                    info.layerNameData = data
                    handleZoomMoveEnd(mapCellsInstancy);
                    callAddLayerOnLayerControl(info, mapCellsInstancy)
                    map.off('zoomend moveend');
                    map.on('zoomend moveend', function () {
                        timeOutFlag = true;

                        handleZoomMoveEnd(mapCellsInstancy);
                    })
                })
                .catch(error => {
                    console.log('Erro:', error);
                });
        }
        uploadFile(fileinput, layerName, fileFormatinputsValues, encondingValue, jsonProcessed.types, info, recordFieldsValues)

        delete mapCellsInstancy.files[fileName];

        divManageScreenLayer.remove()
        document.querySelector('#map-cells-choose-file').value = ''

    })

}

const manageScreenLayer = (contents, mapCellsInstancy) => {

    const divMap = document.querySelector('.map-cells-main')
    let divManageScreenLayer = document.createElement('div');

    // Adicionar classes, atributos ou conteúdo à nova div, se necessário
    divManageScreenLayer.classList.add('map-cells-manage-screen-layer'); // Adiciona uma classe à nova div
    divManageScreenLayer.style.position = 'absolute';

    // Calcular a posição left com base na largura da divMap e 57.5%
    const leftPosition = divMap.offsetWidth * 0.40; // 57.5% de distância do left

    // Definir o estilo left da nova div
    divManageScreenLayer.style.left = `${leftPosition}px`; // Define a posição left em pixels
    divManageScreenLayer.style.top = `5%`; // Define a posição left em pixels

    // Adicionar a nova div dentro da divMap
    divMap.appendChild(divManageScreenLayer);
    createManageScreenLayerContent(divManageScreenLayer, contents, mapCellsInstancy)
}

