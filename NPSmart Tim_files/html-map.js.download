                <span>Category:</span>
                <select class = 'map-cells-select-classify-type'>
                    
                </select>
                <button id='map-cells-classify-button'>Classify</button>
            </div>
            <div class ='map-cells-set-all-values'>
                <input type="number" placeholder='Set all border opacity' min="0" max="100"  class ='map-cells-set-all-border'>
                <input type="number" placeholder='Set all fill opacity' min="0" max="100" class ='map-cells-set-all-fill' >
                <input type="number" placeholder='Set all size' min="0" max="3000" class ='map-cells-set-all-size' >
                <button class='map-cells-set-all'>Apply</button>
            </div>
            <div class='map-cells-symbol-select-forms-options'>
                    <div class= 'map-cells-symbol-select-forms-options-check-azimuth'>
                        <input checked type='checkbox'>
                        <span>Use Azimuth column</span>
                    </div>
                    <div>
                        <span>Azimuth column:</span>
                        <select>
                            ${selectOptions}
                        </select>
                    </div>
                    <div>
                        <span>
                            Aperture angle
                        </span>
                        <input type='number' min='0' max ='360' value = '30'>
                    </div>

                    
                </div>
            <div class = 'map-cells-classified-content'>
                
            </div>
            <button class ='map-cells-add-range'>Add Range</button>
        </div>
        
        

    `



    return screenContent
}

const SingleSymbol = (color, size, opacity, fillOpacity,fileInfo) => {

    let forms = ['circle', 'square', 'diamond', 'cone']
    let formDiv = ''
    forms.forEach(form => {
        formDiv += `
            <div class='map-cells-item-representation'>
                <div class = 'map-cells-format-${form}'>
                </div>
            </div>
        `
    })

    let columnOptions = ''

    for (const [key, value] of Object.entries(fileInfo.headerTypes)) {
        columnOptions += `
            <option value="${key}" type = '${value}'>${key}:<b>${value}</b></option>
        `
    }

    let screenContent = `

        <div class = 'map-cells-edit-symbol-form-representation'>
            <div class = 'map-cells-form-representation'>
                <div class = 'map-cells-form-representation-center'> 
                    <div id ='map-cells-symbol-form'></div>
                </div>
            </div>
            <div class = 'map-cells-form-representation-options'>
                <div class='map-cells-symbol-select-color'>
                    <span>Color:</span>
                    <input type="color"  value="${color}">
                </div>
                <div class='map-cells-symbol-select-fill-opacity'>
                    <span>Fill Opacity:</span>
                    <input type="range" min="0" max="100" value="${fillOpacity * 100}"  >
                </div>
                <div class='map-cells-symbol-select-border-opacity'>
                    <span>Border Opacity:</span>
                    <input type="range" min="0" max="100" value="${opacity * 100}"  >
                </div>
                <div class='map-cells-symbol-select-size'>
                    <span>Size:</span>
                    <input type="number" value='${size}' id="numberInput" min="5" max="3000" step="1">
                    <span>meters</span>
                </div>
                <div class='map-cells-symbol-select-forms-options'>
                    <div class= 'map-cells-symbol-select-forms-options-check-azimuth'>
                        <input checked type='checkbox'>
                        <span>Use Azimuth column</span>
                    </div>
                    <div>
                        <span>Azimuth column:</span>
                        <select>
                            ${columnOptions}
                        </select>
                    </div>
                    <div>
                        <span>
                            Aperture angle
                        </span>
                        <input type='number' min='0' max ='360' value = '30'>
                    </div>

                    
                </div>
                
            </div>
        </div>
        <div class= 'map-cells-edit-symbol-list-forms'>
            ${formDiv}
        </div>

    `

    return screenContent
}


const setFormSymbolStyle = (styles) => {
    let forms = ['circle', 'square', 'diamond', 'cone']

    let form = styles.form
    let size = styles.size
    let color = styles.color
    let opacity = styles.opacity
    let fillOpacity = styles.fillOpacity

    let divform = document.querySelector('#map-cells-symbol-form')
    divform.className = 'map-cells-format-' + form

    console.log(styles)

    forms.forEach(element => {
        switch (element) {
            // case 'cone':
            //     $(`.map-cells-format-${element}`).css({
            //         'border-left': `5vh solid transparent`,
            //         'border-right': `5vh solid transparent`,
            //         'border-top': `5vh solid rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${fillOpacity})`,
                    
            //     })
            //     break;

            default:
                
                $(`.map-cells-format-${element}`).css({
                    'background-color': `rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${fillOpacity})`,
                    'border': `2px solid rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${opacity})`
                })
                console.log('entrei no default')

                break;
        }
    })

    switch (form) {
        case 'cone':
            $('.map-cells-symbol-select-forms-options').css('display','flex')
        //     $(divform).css({
        //         'background-color': `transparent`,
        //         'height': '0',
        //         'width': '0',
        //         'border': `transparent`,
        //         'border-left': `${size}px solid transparent`,
        //         'border-right': `${size}px solid transparent`,
        //         'border-top': `${size}px solid rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${fillOpacity})`,
        //     })
            break;
    
        default:
            $('.map-cells-symbol-select-forms-options').css('display','none')
            $(divform).css({
                'background-color': `rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${fillOpacity})`,
                'height': size,
                'width': size,
                'border': `2px solid rgba(${parseInt(color.slice(1, 3), 16)}, ${parseInt(color.slice(3, 5), 16)}, ${parseInt(color.slice(5, 7), 16)}, ${opacity})`
            })
            break;
    }
    

    


}

const setDistinctDivs = (mapInfo) => {
    let categoriesDivs = `
    <div class= 'map-cells-option-classified-titles'>
        <span>Value</span>
        <span>Color</span>
        <span>Border Opacity</span>
        <span>Fill Opacity</span>
        <span>Size (meters)</span>
    </div>
    
    `;
    document.querySelector('.map-cells-set-all-values').style.display = 'flex'
    let column = mapInfo.columnRef
    for (const [key, values] of Object.entries(mapInfo.categories)) {

        categoriesDivs += `
                <div class ='map-cells-option-classified' column ='${column}'  value='${key}'>
                    <span>${key}</span>  
                    <input type="color" class="map-cells-option-classified-color" value='${values.color}'> 
                    
                    <input type="number" value='${values.opacity}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                    
                    <input type="number" value='${values.fillOpacity}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                    
                    <input type="number" value='${values.size}' class="map-cells-option-classified-size" min="0" max="100" step="1">
                    
                </div>
            `

    }
    document.querySelector('.map-cells-classified-content').innerHTML = categoriesDivs


    
}

const setRangeDivs = (ranges) => {
    let newRangesOptions = `
    <div class= 'map-cells-option-classified-titles'>
        <span>Min</span>
        <span>~</span>
        <span>Max</span>
        <span>Color</span>
        <span>Border Opacity</span>
        <span>Fill Opacity</span>
        <span>Size (meters)</span>
        <span></span>
    </div>
`
    document.querySelector('.map-cells-set-all-values').style.display = 'flex'
    let i = 0;
    let lastItem = ranges.length - 1
    ranges.forEach(range => {


        switch (i) {
            case 0:
                newRangesOptions += `
                <div class ='map-cells-option-classified'  value='${i}'>
                    <div class='map-cells-option-classified-range-set'>
                        <input type ='text' value ='${range['min']}' class="map-cells-option-classified-range-min">
                        <button class= 'map-cells-set-inf-value' value ='negative'> - </button>
                    </div>
                    <span> ~ </span>
                    <input type ='text' value ='${range['max']}'  class="map-cells-option-classified-range-max">

                    <input type="color" class="map-cells-option-classified-color" value='${range['color']}'> 
                   
                    <input type="number" value='${range['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                    
                    <input type="number" value='${range['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                    
                    <input type="number" value='${range['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
                    <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
                </div>
                
                `
                break;

            case lastItem:
                newRangesOptions += `
                    <div class ='map-cells-option-classified'  value='${i}'>
                        <input type ='text' value = '${range['min']}' class="map-cells-option-classified-range-min">
                        <span> ~ </span>
                        <div class='map-cells-option-classified-range-set'>
                            <input type ='text' value = '${range['max']}' class="map-cells-option-classified-range-max">
                            <button class= 'map-cells-set-inf-value' value ='positive'> + </button>
                        </div>                                    
                        <input type="color" class="map-cells-option-classified-color" value='${range['color']}'> 
                        
                        <input type="number" value='${range['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                       
                        <input type="number" value='${range['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                        
                        <input type="number" value='${range['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
                        <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
                    </div> 
                `

                break;

            default:
                newRangesOptions += `
                    <div class ='map-cells-option-classified'  value='${i}'>
                        <input type ='text' value = '${range['min']}' class="map-cells-option-classified-range-min">
                        <span> ~ </span>
                        <input type ='text' value = '${range['max']}' class="map-cells-option-classified-range-max">                              
                        <input type="color" class="map-cells-option-classified-color" value='${range['color']}'> 
                        
                        <input type="number" value='${range['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                       
                        <input type="number" value='${range['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                      
                        <input type="number" value='${range['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
                        <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
                    </div> 
                `
                break;
        }
        i++
    })



    // for (let i = 0; i < ranges.length; i++) {
    //     switch (i) {
    //         case 0:
    //             newRangesOptions += `
    //             <div class ='map-cells-option-classified'  value='${i}'>
    //                 <div class='map-cells-option-classified-range-set'>
    //                     <input type ='text' value ='${ranges[i]['min']}' class="map-cells-option-classified-range-min">
    //                     <button class= 'map-cells-set-inf-value' value ='negative'>-∞</button>
    //                 </div>
    //                 <span> ~ </span>
    //                 <input type ='text' value ='${ranges[i]['max']}'  class="map-cells-option-classified-range-max">

    //                 <input type="color" class="map-cells-option-classified-color" value='${ranges[i]['color']}'> 

    //                 <input type="number" value='${ranges[i]['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">

    //                 <input type="number" value='${ranges[i]['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">

    //                 <input type="number" value='${ranges[i]['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
    //                 <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
    //             </div>

    //             `
    //             break;

    //         case ranges.length - 1:
    //             newRangesOptions += `
    //                 <div class ='map-cells-option-classified'  value='${i}'>
    //                     <input type ='text' value = '${ranges[i]['min']}' class="map-cells-option-classified-range-min">
    //                     <span> ~ </span>
    //                     <div class='map-cells-option-classified-range-set'>
    //                         <input type ='text' value = '${ranges[i]['max']}' class="map-cells-option-classified-range-max">
    //                         <button class= 'map-cells-set-inf-value' value ='positive'>+∞</button>
    //                     </div>                                    
    //                     <input type="color" class="map-cells-option-classified-color" value='${ranges[i]['color']}'> 

    //                     <input type="number" value='${ranges[i]['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">

    //                     <input type="number" value='${ranges[i]['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">

    //                     <input type="number" value='${ranges[i]['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
    //                     <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
    //                 </div> 
    //             `

    //             break;

    //         default:
    //             newRangesOptions += `
    //                 <div class ='map-cells-option-classified'  value='${i}'>
    //                     <input type ='text' value = '${ranges[i]['min']}' class="map-cells-option-classified-range-min">
    //                     <span> ~ </span>
    //                     <input type ='text' value = '${ranges[i]['max']}' class="map-cells-option-classified-range-max">                              
    //                     <input type="color" class="map-cells-option-classified-color" value='${ranges[i]['color']}'> 

    //                     <input type="number" value='${ranges[i]['opacity']}' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">

    //                     <input type="number" value='${ranges[i]['fillOpacity']}' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">

    //                     <input type="number" value='${ranges[i]['size']}' class="map-cells-option-classified-size" min="0" max="100" step="1">
    //                     <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
    //                 </div> 
    //             `
    //             break;
    //     }
    // }
    let divClassifiedContents = document.querySelector('.map-cells-classified-content')
    divClassifiedContents.innerHTML = newRangesOptions

    document.querySelectorAll('.map-cells-option-classified-delete').forEach(element => {
        element.addEventListener('click', function () {
            let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))

            ranges.splice(closestOptionDivValue, 1);
            setRangeDivs(ranges)

        })
    })

    document.querySelectorAll('.map-cells-set-inf-value').forEach(element => {
        element.addEventListener('click', function () {
            let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))

            switch (element.getAttribute('value')) {
                case 'positive':
                    document.querySelector('.map-cells-option-classified-range-set .map-cells-option-classified-range-max').value = '+inf'
                    ranges[closestOptionDivValue]['max'] = '+inf'
                    break;
                case 'negative':
                    document.querySelector('.map-cells-option-classified-range-set .map-cells-option-classified-range-min').value = '-inf'
                    ranges[closestOptionDivValue]['min'] = '-inf'
                    break;
                default:
                    break;
            }
        })
    })

    divClassifiedContents.querySelectorAll(`input`).forEach(element => {
        element.addEventListener('input', function () {
            let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))
            switch (this.className) {
                case 'map-cells-option-classified-range-min':
                    ranges[closestOptionDivValue]['min'] = this.value
                    break;
                case 'map-cells-option-classified-range-max':
                    ranges[closestOptionDivValue]['max'] = this.value
                    break;
                case 'map-cells-option-classified-border-opacity':
                    ranges[closestOptionDivValue]['opacity'] = this.value
                    break;
                case 'map-cells-option-classified-fill-opacity':
                    ranges[closestOptionDivValue]['fillOpacity'] = this.value
                    break;
                case 'map-cells-option-classified-size':
                    ranges[closestOptionDivValue]['size'] = this.value
                    break;
                case 'map-cells-option-classified-color':
                    ranges[closestOptionDivValue]['color'] = this.value
                    break;
                default:
                    break;
            }


        })
    })
}

const createEditScreenLayerContent = (divEditScreenLayer, info, mapCellsInstancy) => {

    let titleName = (info.layer === 'newLayer') ? info.name : info.layer;
    var formSymbolStyles = {
        form: mapCellsInstancy.files[titleName].info.form ?? 'circle',
        size: mapCellsInstancy.files[titleName].info.size ?? 10,
        color: mapCellsInstancy.files[titleName].info.color,
        opacity: mapCellsInstancy.files[titleName].info.opacity ?? 1,
        fillOpacity: mapCellsInstancy.files[titleName].info.fillOpacity ?? 0.5,
    }

    let initialScreen;
    let inicialSelectScreenValue;
    if (mapCellsInstancy.files[titleName].info.classifyType != undefined) {
        initialScreen = categorizedSymbols(mapCellsInstancy.files[titleName].info.color, formSymbolStyles.size, formSymbolStyles.opacity, formSymbolStyles.fillOpacity, mapCellsInstancy.files[titleName].info.headerTypes, mapCellsInstancy.files[titleName].info.columnRef,mapCellsInstancy.files[titleName].info)
        inicialSelectScreenValue = 'categorized'
    } else {
        initialScreen = SingleSymbol(mapCellsInstancy.files[titleName].info.color, formSymbolStyles.size, formSymbolStyles.opacity, formSymbolStyles.fillOpacity, mapCellsInstancy.files[titleName].info)
        inicialSelectScreenValue = 'singleSymbol'
    }

    let initialLabelValue = '';

    if(mapCellsInstancy.files[titleName].info.labelHeader != undefined){
        initialLabelValue = mapCellsInstancy.files[titleName].info.labelHeader
    }

    let labelHeaders = ``
    for(let key in mapCellsInstancy.files[titleName].info.headerTypes){
        labelHeaders += `
            <label><input type="checkbox" value="${key}">${key}</option></label>
        `
    }




    // let virtual_select_init = {
    //     ele: `#${element.id}`,
    //     placeholder: `Select ${element.getAttribute('select')}`,
    //     maxWidth: "80%",
    //     multiple: true,
    //     search: true,
    //     options: [],
    // }

    // <div class='map-cells-select-main-edit-label-select '>
    //     <select value = '${initialLabelValue}'>
    //         ${labelHeaders}
    //     </select>
    // </div>
    
    let mainContent = `
            <div class = 'map-cells-select-main-edit-screen-select'>
            <span>Label Headers</span>
            <div class="multi-select">
                <div class="select-btn">Selecione opções</div>
                <div class="select-content">
                    <label><input type="checkbox" id="selectAll"> Selecionar tudo</label>
                    ${labelHeaders}
                </div>
            </div>
            <br>
            <span>Properties</span>
                <select value = '${inicialSelectScreenValue}'>
                    <option value="singleSymbol">Single symbol</option>
                    <option value="categorized">Categorized</option>
                </select>
            </div>   
            <div class = 'map-cells-select-main-edit-screen-content'>
                ${initialScreen}
            </div>
            `

    divEditScreenLayer.innerHTML += `
            <div class = 'map-cells-close-edit-screen'> 
                    <span>Layer properties - ${titleName} - NPGIS</span>
                    <img class = 'map-cells-close-edit-screen-icon' src="/npsmart/images/icon-close.png">
            </div>
            <div class = 'map-cells-main-edit-screen'>
                ${mainContent}
            </div>
            <div class='map-cells-confirmation-edit-screen'> 
                <button id='map-cells-confirmation-edit-cancel'>Cancel</button>
                <button id='map-cells-confirmation-edit-set'>Apply</button>
            </div>
        `

    // --------------- caixinha de labels
    const select = document.querySelector('.multi-select');
    const btn = select.querySelector('.select-btn');
    const checkboxes = select.querySelectorAll('input[type="checkbox"]:not(#selectAll)');
    const selectAll = document.querySelector('#selectAll');
    
    btn.addEventListener('click', () => {
        select.classList.toggle('open');
    });
    
    document.addEventListener('click', (e) => {
        if (!select.contains(e.target)) {
            select.classList.remove('open');
        }
    });
    
    function updateLabel() {
        const selected = Array.from(checkboxes).filter(cb => cb.checked).length;
    
        if (selected === 0) btn.textContent = "Select headers";
        else if (selected === 1) btn.textContent = "1 option selected";
        else btn.textContent = `${selected} options selected`;
    
        selectAll.checked = selected === checkboxes.length;
    }
    
    selectAll.addEventListener('change', () => {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
        updateLabel();
    });
    
    checkboxes.forEach(cb => {
        if(mapCellsInstancy.files[titleName].info.labelHeader !== undefined){
            cb.checked = mapCellsInstancy.files[titleName].info.labelHeader.includes(cb.value);
            updateLabel();
        }
        cb.addEventListener('change', updateLabel);
    });

    // -----------

    document.querySelector('.map-cells-select-main-edit-screen-select select').value = inicialSelectScreenValue
    setFormSymbolStyle(formSymbolStyles)

    let mapInfo = mapCellsInstancy.files[titleName].info
    var ranges;
    if (mapInfo.classifyType == "range") {
        setRangeDivs(mapInfo.categories);
        ranges = mapInfo.categories
        document.querySelector('.map-cells-add-range').style.display = 'inline'
        document.querySelector('.map-cells-add-range').removeEventListener('click', function () {
            addRange()
        })
        document.querySelector('.map-cells-add-range').addEventListener('click', function () {
            addRange()
        })
        document.querySelector('.map-cells-select-classify-value').value = mapInfo.columnRef
        document.querySelector('.map-cells-select-classify-type').value = 'range'
    } else if (mapInfo.classifyType == "distinct") {
        ranges = []
        setDistinctDivs(mapInfo)
        document.querySelector('.map-cells-select-classify-value').value = mapInfo.columnRef
        document.querySelector('.map-cells-select-classify-type').value = "distinct"
    } else {
        ranges = []
    }





    function addRange() {
        let lastItem = ranges[ranges.length - 1]
        let lastMax = ranges[ranges.length - 2].max
        ranges[ranges.length - 1] = {
            min: lastMax,
            max: lastMax,
            color: colorHexa(),
            size: 10,
            opacity: 100,
            fillOpacity: 50,
        }
        ranges[ranges.length] = lastItem


        setRangeDivs(ranges)

        return ranges
    }

    function addEventsSingleSymbol() {
        try {
            document.querySelector('.map-cells-symbol-select-forms-options div select').value = mapCellsInstancy.files[titleName].info.z
            document.querySelector('.map-cells-symbol-select-color input').addEventListener('input', function () {
                formSymbolStyles.color = this.value
                setFormSymbolStyle(formSymbolStyles)
            })
            document.querySelector('.map-cells-symbol-select-fill-opacity input').addEventListener('input', function () {
                formSymbolStyles.fillOpacity = this.value / 100
                setFormSymbolStyle(formSymbolStyles)
            })
            document.querySelector('.map-cells-symbol-select-border-opacity input').addEventListener('input', function () {
                formSymbolStyles.opacity = this.value / 100
                setFormSymbolStyle(formSymbolStyles)
            })
            document.querySelector('.map-cells-symbol-select-size #numberInput').addEventListener('input', function () {
                formSymbolStyles.size = this.value
                setFormSymbolStyle(formSymbolStyles)
            })
        } catch (error) {

        }


        document.querySelectorAll('.map-cells-item-representation').forEach(element => {
            element.addEventListener('click', function () {
                $('.map-cells-item-representation').css('border-color', '#DDD')
                $(this).css('border-color', '#00F')
                let newClassName = this.querySelector('[class^="map-cells-format-"]').className
                formSymbolStyles.form = newClassName.replace('map-cells-format-', '')
                setFormSymbolStyle(formSymbolStyles)
            })
        })
    }

    function addEventsCategorizedSymbol() {
        document.querySelector('.map-cells-symbol-select-forms-options div select').value = mapCellsInstancy.files[titleName].info.z

        document.querySelector('.map-cells-set-all').addEventListener('click', function () {
            let classifyType = document.querySelector('.map-cells-select-classify-type').value
            let borderValue = document.querySelector('.map-cells-set-all-border').value;
            let fillValue = document.querySelector('.map-cells-set-all-fill').value;
            let sizeValue = document.querySelector(".map-cells-set-all-size").value;
            switch (classifyType) {
                case 'range':
                    mapCellsInstancy.files[titleName].info.categories.forEach(element => {
                        element.fillOpacity = (fillValue != '') ? fillValue : element.fillOpacity
                        element.opacity = (borderValue != '') ? borderValue : element.opacity
                        element.size = (sizeValue != '') ? sizeValue : element.size
                    })
                    setRangeDivs(mapCellsInstancy.files[titleName].info.categories)

                    break;
                case 'distinct':
                    if (borderValue != '') {
                        document.querySelectorAll('.map-cells-option-classified-border-opacity').forEach(element => {
                            element.value = borderValue
                        })

                    }
                    if (fillValue != '') {
                        document.querySelectorAll('.map-cells-option-classified-fill-opacity').forEach(element => {
                            element.value = fillValue
                        })

                    }
                    if (sizeValue != '') {
                        document.querySelectorAll('.map-cells-option-classified-size').forEach(element => {
                            element.value = sizeValue
                        })

                    }
                    break;
                default:
                    break;
            }
        })

        document.querySelectorAll('.map-cells-item-representation').forEach(element => {
            element.addEventListener('click', function () {
                $('.map-cells-item-representation').css('border-color', '#DDD')
                $(this).css('border-color', '#00F')
                let newClassName = this.querySelector('[class^="map-cells-format-"]').className
                formSymbolStyles.form = newClassName.replace('map-cells-format-', '')
                setFormSymbolStyle(formSymbolStyles)
            })
        })

        function updateClassifyOptions() {
            let selectClassifyValue = document.querySelector('.map-cells-select-classify-value');
            let selectedOption = selectClassifyValue.options[selectClassifyValue.selectedIndex];
            let type = selectedOption.getAttribute('type');
            let optionsTypes = '';

            if (type === 'TEXT') {
                optionsTypes = '<option value="distinct">Distinct</option>';
            } else {
                optionsTypes = `
                    <option value="distinct">Distinct</option>
                    <option value="range">Range</option>
                `;
            }
            document.querySelector('.map-cells-select-classify-type').innerHTML = optionsTypes;

        }

        document.querySelector('.map-cells-select-classify-value').addEventListener('change', function () {
            updateClassifyOptions()
        })
        updateClassifyOptions()
        if (mapInfo.classifyType == "range") {
            document.querySelector('.map-cells-select-classify-type').value = 'range'
        } else if (mapInfo.classifyType == "distinct") {
            ranges = []
            document.querySelector('.map-cells-select-classify-type').value = "distinct"
        }


        document.querySelector('#map-cells-classify-button').addEventListener('click', function () {

            $.ajax({
                url: "/npsmart/map/get_data_to_classify",
                method: 'POST',
                data: {
                    table: titleName,
                    category: document.querySelector('.map-cells-select-classify-type').value,
                    column: document.querySelector('.map-cells-select-classify-value').value,
                },
                success: function (result) {
                    let column = document.querySelector('.map-cells-select-classify-value').value
                    let type = document.querySelector('.map-cells-select-classify-type').value
                    result = JSON.parse(result)
                    let classifiedOptions = ''
                    document.querySelector('.map-cells-set-all-values').style.display = 'flex'
                    switch (type) {
                        case 'distinct':
                            document.querySelector('.map-cells-add-range').style.display = 'none'
                            classifiedOptions = `
                                <div class= 'map-cells-option-classified-titles'>
                                    <span>Value</span>
                                    <span>Color</span>
                                    <span>Border Opacity</span>
                                    <span>Fill Opacity</span>
                                    <span>Size (meters)</span>
                                </div>
                            `
                            ranges = []
                            for (let i = 0; i < result.length; i++) {

                                classifiedOptions += `
                                    <div class ='map-cells-option-classified' value='${result[i][column]}'>
                                        <span>${result[i][column]}</span>  
                                        <input type="color" class="map-cells-option-classified-color" value='${colorHexa()}'> 
                                        
                                        <input type="number" value='100' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                                        
                                        <input type="number" value='50' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                                      
                                        <input type="number" value='10' class="map-cells-option-classified-size" min="0" max="100" step="1">
                                    </div>
                                `
                            }
                            break;
                        case 'range':
                            ranges = []
                            let initialValue = Math.ceil((parseFloat(result[0]['min']) + parseFloat(result[0]['max'])) / 2)
                            document.querySelector('.map-cells-add-range').style.display = 'inline'
                            let firstColor = colorHexa()
                            let secondColor = colorHexa()
                            classifiedOptions += `
                                <div class= 'map-cells-option-classified-titles'>
                                    <span>Min</span>
                                    <span>~</span>
                                    <span>Max</span>
                                    <span>Color</span>
                                    <span>Border Opacity</span>
                                    <span>Fill Opacity</span>
                                    <span>Size (meters)</span>
                                    <span></span>
                                </div>
                                    <div class ='map-cells-option-classified' column ='${column}'  value='${0}'>
                                        <div class='map-cells-option-classified-range-set'>
                                            <input type ='text' value = '-inf' class="map-cells-option-classified-range-min">
                                            <button class= 'map-cells-set-inf-value' value ='negative'> - </button>
                                        </div>
                                        <span> ~ </span>
                                        <input type ='text' value ='${initialValue}'  class="map-cells-option-classified-range-max">

                                        <input type="color" class="map-cells-option-classified-color" value='${firstColor}'> 
                                       
                                        <input type="number" value='100' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                                        
                                        <input type="number" value='50' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                                        
                                        <input type="number" value='10' class="map-cells-option-classified-size" min="0" max="100" step="1">
                                        <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">
                                    </div>
                                    <div class ='map-cells-option-classified' column ='${column}'  value='${1}'>
                                    
                                        <input type ='text' value = '${initialValue}' class="map-cells-option-classified-range-min">
                                        <span> ~ </span>
                                        <div class='map-cells-option-classified-range-set'>
                                            <input type ='text' value = '+inf' class="map-cells-option-classified-range-max">
                                            <button class= 'map-cells-set-inf-value' value ='positive'> + </button>
                                        </div>                                    
                                        <input type="color" class="map-cells-option-classified-color" value='${secondColor}'> 
                                        
                                        <input type="number" value='100' class="map-cells-option-classified-border-opacity" min="0" max="100" step="1">
                                      
                                        <input type="number" value='50' class="map-cells-option-classified-fill-opacity" min="0" max="100" step="1">
                                       
                                        <input type="number" value='10' class="map-cells-option-classified-size" min="0" max="100" step="1">
                                        <img class ='map-cells-option-classified-delete' src="/npsmart/images/icon-close.png">

                                    </div>
                            `
                            ranges = [
                                {
                                    min: '-inf',
                                    max: initialValue,
                                    color: firstColor,
                                    size: 10,
                                    opacity: 100,
                                    fillOpacity: 50,
                                },
                                {
                                    min: initialValue,
                                    max: '+inf',
                                    color: secondColor,
                                    size: 10,
                                    opacity: 100,
                                    fillOpacity: 50,
                                }
                            ]
                            document.querySelector('.map-cells-add-range').removeEventListener('click', function () {
                                addRange()
                            })
                            document.querySelector('.map-cells-add-range').addEventListener('click', function () {
                                addRange()

                            })
                            mapCellsInstancy.files[titleName].info.categories = ranges
                            break;
                        default:
                            break;
                    }

                    document.querySelector('.map-cells-classified-content').innerHTML = classifiedOptions
                    if (type == 'range') {

                        document.querySelectorAll('.map-cells-option-classified-delete').forEach(element => {
                            element.addEventListener('click', function () {
                                let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))

                                ranges.splice(closestOptionDivValue, 1);
                                setRangeDivs(ranges)

                            })
                        })

                        document.querySelectorAll('.map-cells-set-inf-value').forEach(element => {
                            element.addEventListener('click', function () {
                                let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))

                                switch (element.getAttribute('value')) {
                                    case 'positive':
                                        document.querySelector('.map-cells-option-classified-range-set .map-cells-option-classified-range-max').value = '+inf'
                                        ranges[closestOptionDivValue]['max'] = '+inf'
                                        break;
                                    case 'negative':
                                        document.querySelector('.map-cells-option-classified-range-set .map-cells-option-classified-range-min').value = '-inf'
                                        ranges[closestOptionDivValue]['min'] = '-inf'
                                        break;
                                    default:
                                        break;
                                }
                            })
                        })

                        let divClassifiedContents = document.querySelector('.map-cells-classified-content')

                        divClassifiedContents.querySelectorAll(`input`).forEach(element => {
                            element.addEventListener('input', function () {
                                let closestOptionDivValue = parseInt(this.closest('.map-cells-option-classified').getAttribute('value'))
                                switch (this.className) {
                                    case 'map-cells-option-classified-range-min':
                                        ranges[closestOptionDivValue]['min'] = this.value
                                        break;
                                    case 'map-cells-option-classified-range-max':
                                        ranges[closestOptionDivValue]['max'] = this.value
                                        break;
                                    case 'map-cells-option-classified-border-opacity':
                                        ranges[closestOptionDivValue]['opacity'] = this.value
                                        break;
                                    case 'map-cells-option-classified-fill-opacity':
                                        ranges[closestOptionDivValue]['fillOpacity'] = this.value
                                        break;
                                    case 'map-cells-option-classified-size':
                                        ranges[closestOptionDivValue]['size'] = this.value
                                        break;
                                    case 'map-cells-option-classified-color':
                                        ranges[closestOptionDivValue]['color'] = this.value
                                        break;
                                    default:
                                        break;
                                }


                            })
                        })
                    }


                },

                error: function (error) {

                }
            });
        })

    }


    if (inicialSelectScreenValue == 'categorized') {
        addEventsCategorizedSymbol()
    } else {
        addEventsSingleSymbol()

    }


    document.querySelector('#map-cells-confirmation-edit-set').addEventListener('click', function () {
        let screen = document.querySelector('.map-cells-select-main-edit-screen-select select').value
        // let labelHeader = document.querySelector('.map-cells-select-main-edit-label-select select').value
        let labelHeader = Array.from(document.querySelectorAll('.multi-select input[type="checkbox"]:checked')).map(cb => cb.value);
        let useAzimuthColumn = document.querySelector('.map-cells-symbol-select-forms-options-check-azimuth input').checked
        let columnZ = document.querySelector('.map-cells-symbol-select-forms-options select').value
        let apertureAngle = document.querySelector('.map-cells-symbol-select-forms-options input[type="number"]').value
        mapCellsInstancy.files[titleName].info.useAzimuthColumn = useAzimuthColumn
        mapCellsInstancy.files[titleName].info.apertureAngle = apertureAngle
        mapCellsInstancy.files[titleName].info.z = columnZ
        mapCellsInstancy.files[titleName].info.labelHeader = labelHeader
        switch (screen) {
            case 'singleSymbol':
                
                mapCellsInstancy.files[titleName].info.classifyType = undefined
                mapCellsInstancy.files[titleName].info.columnRef = null

                mapCellsInstancy.files[titleName].info.form = formSymbolStyles.form
                mapCellsInstancy.files[titleName].info.size = formSymbolStyles.size
                mapCellsInstancy.files[titleName].info.color = formSymbolStyles.color
                mapCellsInstancy.files[titleName].info.opacity = formSymbolStyles.opacity
                mapCellsInstancy.files[titleName].info.fillOpacity = formSymbolStyles.fillOpacity

                break;
            case 'categorized':
                mapCellsInstancy.files[titleName].info.form = formSymbolStyles.form
                let mapInfo = mapCellsInstancy.files[titleName].info
                let categorizeType = document.querySelector('.map-cells-select-classify-type').value
                mapInfo.classifyType = categorizeType
                mapInfo.columnRef = document.querySelector('.map-cells-select-classify-value').value
                switch (categorizeType) {
                    case 'distinct':
                        let optionsDivs = document.querySelectorAll('.map-cells-option-classified')

                        mapInfo.categories = {}
                        optionsDivs.forEach(element => {
                            let value = element.getAttribute('value')
                            let color = element.querySelector('.map-cells-option-classified-color').value;
                            let fillOpacity = element.querySelector('.map-cells-option-classified-fill-opacity').value;
                            let opacity = element.querySelector('.map-cells-option-classified-border-opacity').value;
                            let size = element.querySelector('.map-cells-option-classified-size').value
                            mapInfo.categories[value] = {}
                            mapInfo.categories[value].color = color
                            mapInfo.categories[value].fillOpacity = fillOpacity
                            mapInfo.categories[value].opacity = opacity
                            mapInfo.categories[value].size = size
                        })

                        break;
                    case 'range':
                        mapInfo.categories = ranges
                        break;

                    default:
                        break;
                }

                break;
            default:
                break;
        }


        add_subtitle_file_layer(mapCellsInstancy.files)

        handleZoomMoveEnd(mapCellsInstancy)
        blockUi(false, mapCellsInstancy)
        divEditScreenLayer.remove()

    })

    

    document.querySelector('.map-cells-select-main-edit-screen-select select').addEventListener('change', function () {
        switch (this.value) {
            case 'categorized':
                document.querySelector('.map-cells-select-main-edit-screen-content').innerHTML = categorizedSymbols(formSymbolStyles.color, formSymbolStyles.size, formSymbolStyles.opacity, formSymbolStyles.fillOpacity, mapCellsInstancy.files[titleName].info.headerTypes)
                formSymbolStyles.size = 60
                addEventsCategorizedSymbol()
                break;
            case 'singleSymbol':
                document.querySelector('.map-cells-select-main-edit-screen-content').innerHTML = SingleSymbol(formSymbolStyles.color, formSymbolStyles.size, formSymbolStyles.opacity, formSymbolStyles.fillOpacity,mapCellsInstancy.files[titleName].info)
                addEventsSingleSymbol()
                break;
            default:
                break;
        }
        setFormSymbolStyle(formSymbolStyles)

    })

    document.querySelector('#map-cells-confirmation-edit-cancel').addEventListener('click', function () {
        divEditScreenLayer.remove()
        blockUi(false, mapCellsInstancy)
    })
    document.querySelector('.map-cells-close-edit-screen-icon').addEventListener('click', function () {
        divEditScreenLayer.remove()
        blockUi(false, mapCellsInstancy)
    })

}

const callEditLayer = (divLayer, mapCellsInstancy) => {
    const divMap = document.querySelector('.map-cells-main')
    let divEditScreenLayer = document.createElement('div');

    divEditScreenLayer.classList.add('map-cells-edit-screen-layer');
    divEditScreenLayer.style.position = 'absolute';


    const leftPosition = divMap.offsetWidth * 0.40;

    divEditScreenLayer.style.left = `${leftPosition}px`;
    divEditScreenLayer.style.top = `5%`;
    let info = {
        layer: divLayer.getAttribute('layer'),
        tec: divLayer.getAttribute('tech'),
        name: divLayer.getAttribute('layerName')
    }

    divMap.appendChild(divEditScreenLayer);
    createEditScreenLayerContent(divEditScreenLayer, info, mapCellsInstancy)
    blockUi(true, mapCellsInstancy)

}