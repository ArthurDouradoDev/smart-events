                <input type='text'>
            </div>
            <div>
                <span>Scape</span>
                <input type='text'>
            </div>
 
        </div>
    `

    let recordFieldsContent = `
        <div value ='headerNumber' class ='map-cells-record-fields-set'>
            <div>
                <span>Number of header lines to discard:</span>
                <input type="number"  min="0" value='0'/>
