    }


    let screenContent = `
        <div class = 'map-cells-edit-symbol-form-representation'>
            <div class = 'map-cells-form-representation'>
                <div class = 'map-cells-form-representation-center'> 
                    <div id ='map-cells-symbol-form'></div>
