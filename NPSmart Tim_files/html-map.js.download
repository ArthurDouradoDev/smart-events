const createHtmlLeftMenu = (element, mapInstancy) => {
    console.log('createHtmlLeftMenu')
    let card = '';
    switch (element) {
        case 'control_panel':

            mapInstancy.techs.forEach(tech => {
                card += `
                <div class="map-cells-control-panel map-cells-controller">
                    <h5>${tech} control</h5>
                    <div class='map-cells-set'>
                        <label><b>UF:</b></label>
                        <div class='map-cells-select-menu' select='uf' tech='${tech}' id='map-cells-control-panel-select-uf${tech}'></div>
                    </div>
                    <div class='map-cells-set'>
                        <label><b>City:</b></label>
                        <div class='map-cells-select-menu' select='cities' tech='${tech}' id='map-cells-control-panel-select-cities${tech}'></div>
                    </div>
                    <div class='map-cells-set'>
                        <label><b>Station:</b></label>
                        <div class='map-cells-select-menu' select='station' tech='${tech}' id='map-cells-control-panel-select-station${tech}'></div>
                    </div>
                    <div class='map-cells-set'>
                        <label><b>Cell:</b></label>
                        <div class='map-cells-select-menu' select='cell' tech='${tech}' id='map-cells-control-panel-select-cell${tech}'></div>
                    </div>
                </div>
                `
            })
            card += `<div class="map-cells-control-panel map-cells-controller">
                        <div style="display:flex;align-items:center">
                            <input type="checkbox" onclick="getStationNames()" id="labels" style="display:inline-block;margin: 2px 2px 0 0" />Station Names
                        </div>
                    </div>`
            break;

        case 'cell_propagation':
            mapInstancy.techs.forEach(tech => {
                let date = mapInstancy.propagationDates[tech] !== undefined ? `<p>${mapInstancy.propagationDates[tech]}</p>` : ''
                card += `
                <div class="map-cells-cell-propagation map-cells-controller">
                    <h5>${tech} Propagation</h5>
                    ${date}
                    <div class='map-cells-set'>
                        <label><b>Cell:</b></label>
                        <div class='map-cells-select-menu' select='cell' tech='${tech}' id='map-cells-cell-propagation-select-cell${tech}'></div>
                    </div>
                </div>
                `
            })
            break;
        case 'ookla':
            mapInstancy.techs.forEach(tech => {
                if (tech != '3G') {
                    card += `
                        <div class="map-cells-ookla map-cells-controller">
                            <h5>${tech} Ookla</h5>
                            <div class='map-cells-set'>
                                <label ><b>Date:</b></label>
                                <input type="text" id="dateRangePicker${tech}" tech="${tech}" class="map-cells-input-date" placeholder="Select Date Range">
                            </div>
                            <div class='map-cells-set'>
                                <label><b>UF:</b></label>
                                <div class='map-cells-select-menu' select='uf' tech='${tech}' id='map-cells-ookla-select-uf${tech}'></div>
                            
                            </div>
                        </div>
                    `
                }

            })
            break;
        case 'tools':

            mapInstancy.tools.forEach(element => {
                switch (element) {
                    case 'ruler':
                        card += `
                    <div class="map-cells-tools map-cells-controller">
                        <div class='map-cells-set'>
                            <div class="map-cells-ruler">
                                <img src="/npsmart/images/ruller.png" alt="" class="map-cells-icon-ruler">
                            </div>
                            <div class='map-cells-measures-area'>
                                <canvas id="elevationChart"></canvas>
                            </div>
                        </div>
                    </div>
                `
                        break;
                    case 'compass':
                        card += `
                        <div class="map-cells-tools map-cells-controller">
                            <div class='map-cells-set'>
                                <div class="map-cells-compass">
                                    <img src="/npsmart/images/bussola-static.png" alt="" class="map-cells-icon-compass">
                                </div>
                                <div class='map-cells-compass-input-area'>
                                    <input class='map-cells-compass-latitude' placeholder="Latitude" type="text">
                                    <input class='map-cells-compass-longitude'  placeholder="Longitude" type="text">
                                </div>
                            </div>
                        </div>
                    `
                        break;

                    default:
                        break;
                }

            })

            break;
        case 'csv':
            card += `
                        <div class="map-cells-csv map-cells-controller">
                            <h5>Drag and drop a file here or click to select</h5>
                            <div class='map-cells-set'>
                                <input type="file" id="map-cells-choose-file" accept="csv">
                            </div>
                            
                        </div>
                    `
    }


    return card;
}

const createHtmlRightMenu = (element, mapInstancy) => {
    console.log('createHtmlRightMenu')

    let card = '<div class="map-cells-subtitles-agregation">';
    let agregation_content = ''
    switch (element) {
        case 'control_panel':
            agregation_content = '<div class="map-cells-agregation-content">'
            mapInstancy.techs.forEach(tech => {
                if (mapInstancy.frequencies[tech] != undefined) {
                    let tech_div = `<div class ='map-cells-tech-subtitle' id='subtitle-petalMapCell${tech}' >
                        <div class='map-cells-subtitle-title'>
                            <span>${tech}</span>
                        </div>
                        <div class = map-cells-subtitle-agregation-frequencies>
                        
                        `
                    for (const [frequency, values] of Object.entries(mapInstancy.frequencies[tech])) {

                        tech_div += `
                            <div class='map-cells-subtitle-frequency map-cells-subtitle-info' frequency='${frequency}' tech='${tech}'  style='background-color: ${values['color']}; color:${values['font']} ' ><b><span>${frequency}MHz</span></b></div>
                            `


                    }
                    tech_div += `</div></div>`
                    agregation_content += tech_div
                }


            })
            agregation_content += `</div>`
            card += `
            ${agregation_content}
            </div>
                `
            break;
        case 'cell_propagation':
            agregation_content = '<div class="map-cells-agregation-content">'

            let tech_div = `<div class ='map-cells-tech-subtitle' id = 'subtitle-mapCellsPropagationDelay'>
            <div class='map-cells-subtitle-title'>
                <span>Propagation Layers</span>
            </div>
            <div class = map-cells-subtitle-agregation-frequencies>
            
            `

            tech_div += `
                <div class='map-cells-subtitle-info'  style='background-color: ${mapInstancy.propagationDelayConsts['colors']['green']};  ' ><b><span>< 3%</span></b></div>
                <div class='map-cells-subtitle-info'  style='background-color: ${mapInstancy.propagationDelayConsts['colors']['yellow']};' ><b><span>< 5%</span></b></div>
                <div class='map-cells-subtitle-info'  style='background-color: ${mapInstancy.propagationDelayConsts['colors']['orange']};  ' ><b><span>< 15%</span></b></div>
                <div class='map-cells-subtitle-info'  style='background-color: ${mapInstancy.propagationDelayConsts['colors']['dark_orange']}; color:#FFF ' ><b><span>< 30%</span></b></div>
                <div class='map-cells-subtitle-info'  style='background-color: ${mapInstancy.propagationDelayConsts['colors']['red']}; color:#FFF ' ><b><span>> 30%</span></b></div>

                `
            tech_div += `</div></div>`
            agregation_content += tech_div
            agregation_content += `</div>`
            card += `
            ${agregation_content}
            </div>
                `
            break;
        case 'ookla':
            agregation_content = '<div class="map-cells-agregation-content">'

            mapInstancy.techs.forEach(element => {
                if (element != '3G') {
                    let tech_div = `<div class ='map-cells-tech-subtitle' id='subtitle-mapCellsOoklaDots${element}'>
                    <div class='map-cells-subtitle-title'>
                        <span>Ookla ${element}</span>
                    </div>
                    <div class = map-cells-subtitle-agregation-frequencies>
                    
                    `
                    tech_div += `
                        <div class='map-cells-subtitle-info' selected="true" tech="${element}" value=${mapInstancy.ooklaVelocity[element][0]} style="background-color: #ff0101;color: white;box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset" ><b><span>< ${mapInstancy.ooklaVelocity[element][0]}Mbps</span></b></div>
                        <div class='map-cells-subtitle-info' selected="true" tech="${element}" value=${mapInstancy.ooklaVelocity[element][1]} style="background-color: #ffc0cc;box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset" ><b><span>< ${mapInstancy.ooklaVelocity[element][1]}Mbps</span></b></div>
                        <div class='map-cells-subtitle-info' selected="true" tech="${element}" value=${mapInstancy.ooklaVelocity[element][2]} style="background-color: #fefd02;box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset";><b><span>< ${mapInstancy.ooklaVelocity[element][2]}Mbps</span></b></div>
                        <div class='map-cells-subtitle-info' selected="true" tech="${element}" value=${mapInstancy.ooklaVelocity[element][3]} style="background-color: #00ff03;box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset" ><b><span>< ${mapInstancy.ooklaVelocity[element][3]}Mbps</span></b></div>
                        <div class='map-cells-subtitle-info' selected="true" tech="${element}" value=${46} style="background-color: #0473ff;color: white;box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset"><b><span>> ${mapInstancy.ooklaVelocity[element][3]}Mbps</span></b></div>

                        `
                    tech_div += `</div></div>`
                    agregation_content += tech_div

                }
            })
            agregation_content += `</div>`
            card += `
            ${agregation_content}
            </div>
                `
            break;


    }


    return card;
}

const createHtmlMap = (mapInstancy) => {
    console.log('createHtmlMap')
    let html_menu = ''
