        // document.querySelector('.map-cells-show-hide-menu-right').addEventListener('click', function () {
        //     if (!menu_right_hidden) {
        //         previousSubtitleWidth = document.querySelector('.map-cells-subtitle').style.width;
        //         previousSubtitleMinWidth = document.querySelector('.map-cells-subtitle').style.minWidth;
        //         previousArrowRight = document.querySelector('.map-cells-show-hide-menu-right').style.right;

        //         // document.querySelector('.map-cells-tabs').style.opacity = '0'
        //         // document.querySelector('.map-cells-card-menu').style.opacity = '0'

        //         document.querySelector('.map-cells-subtitle').style.minWidth = '0'
        //         document.querySelector('.map-cells-subtitle').style.width = '0'
        //         document.querySelector('.map-cells-show-hide-menu-right').style.right = '0'
        //         document.querySelector('.map-cells-show-hide-menu-right img').style.transform = 'rotate(180deg)';

        //         menu_right_hidden = !menu_right_hidden
        //     } else {
        //         // document.querySelector('.map-cells-tabs').style.opacity = '1'
        //         // document.querySelector('.map-cells-card-menu').style.opacity = '1'

        //         document.querySelector('.map-cells-subtitle').style.minWidth = previousSubtitleMinWidth
        //         document.querySelector('.map-cells-subtitle').style.width = previousSubtitleWidth
        //         document.querySelector('.map-cells-show-hide-menu-right').style.right = previousArrowRight
        //         document.querySelector('.map-cells-show-hide-menu-right img').style.transform = 'rotate(0deg)';

        //         menu_right_hidden = !menu_right_hidden

        //     }
        // })
        if (mapInstancy.menus.right.includes('control_panel')) {
            const subtitle_frequency = document.querySelectorAll('.map-cells-subtitle-frequency')
            subtitle_frequency.forEach(function (element) {
                element.addEventListener('click', function () {

                    let data = {
                        state: document.querySelector(`#map-cells-control-panel-select-uf${element.getAttribute('tech')}`).value,
                        city: document.querySelector(`#map-cells-control-panel-select-cities${element.getAttribute('tech')}`).value,
                        station: document.querySelector(`#map-cells-control-panel-select-station${element.getAttribute('tech')}`).value,
                        cell: document.querySelector(`#map-cells-control-panel-select-cell${element.getAttribute('tech')}`).value,
                    };


                    data.frequency = element.getAttribute('frequency');
                    data.tec = element.getAttribute('tech')

                    if (element.getAttribute('selected') == 'true') {
                        removeLayerMap('petalMapCell', {
                            tec: data.tec,
                            frequency: data.frequency,
                        },
                            mapInstancy)
                        element.setAttribute('selected', 'false');
                        element.style.boxShadow = '0px 4px 4px 0px rgba(0, 0, 0, 0.30)'

                    } else {
                        element.style.boxShadow = 'rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset'

                        callCellDataBySubtitles(data, mapInstancy)
                        element.setAttribute('selected', 'true');
                    }

                })
            })
        }

        if (mapInstancy.menus.left.includes('csv')) {

            document.querySelector('#map-cells-choose-file').addEventListener('change', function () {

                var file = this.files[0];

                var reader = new FileReader();

                reader.onload = function (e) {
                    var contents = e.target.result;
                    manageScreenLayer(contents, mapInstancy)
                    blockUi(true, mapInstancy)

                };

                reader.readAsText(file);
            })
        }

        if (mapInstancy.menus.left.includes('ookla')) {
            const elements = document.querySelectorAll('[id^="subtitle-mapCellsOoklaDots"]');

            // Passo 2: Itera sobre cada um desses elementos para encontrar os descendentes com a classe '.subtitles'
            elements.forEach(element => {
                // Seleciona os elementos com a classe '.subtitles' dentro do elemento atual
                const subtitles = element.querySelectorAll('.map-cells-subtitle-info');

                // Itera sobre os elementos encontrados e faz algo com cada um
                subtitles.forEach(subtitle => {
                    subtitle.addEventListener("click", function () {

                        if (subtitle.getAttribute("selected") == "true") {
                            subtitle.setAttribute("selected", "false")
                            subtitle.style.boxShadow = '0px 4px 4px 0px rgba(0, 0, 0, 0.30)'
                        } else {
                            subtitle.setAttribute("selected", "true")
                            subtitle.style.boxShadow = 'rgba(0, 0, 0, 0.3) 0px 4px 4px 0px inset'
                        }

                        let tech = {
                            tec: subtitle.getAttribute("tech")
                        }

                        removeLayerMap('mapCellsOoklaDots', {
                            tec: subtitle.getAttribute('tech')
                        },
                            mapInstancy)
                        callOoklaData(tech, mapInstancy)

                    })
                });
            });
        }

    }
};


const filterBounds = (data, bounds, info) => {

    var filteredPoints = data.filter(function (ponto) {
        var lat = ponto[`${info['y']}`]
        var lng = ponto[`${info['x']}`];
        if (lat != undefined && lng != undefined) {

            return bounds.contains([parseFloat(lat), parseFloat(lng)]);
        }

    });
    return filteredPoints;
}


const calcProporcao = (dataLength, zoom) => {
    let DataMin = 1000;
    let DataMax = 4000;
    let ZoomMin = 1;
    let ZoomMax = 17;

    let SizeMin = 60;
    let SizeMax = 10;

    if (zoom >= ZoomMax) {
        return {
            proportionData: 1,
            proportionSize: 10
        } // Se o zoom for maior ou igual ao máximo, retorna o máximo de dados

    }

    // Calcula a proporção linearmente entre DataMin e DataMax conforme o zoom varia de ZoomMin a ZoomMax
    let proportion = DataMin + (zoom - ZoomMin) * (DataMax - DataMin) / (ZoomMax - ZoomMin);
    let proportionSize = SizeMin + (zoom - ZoomMin) * (SizeMax - SizeMin) / (ZoomMax - ZoomMin);

    // Arredonda o resultado para o inteiro mais próximo
    return {
        proportionData: Math.round(parseInt(dataLength) / parseInt(proportion)),
        proportionSize: Math.round(proportionSize)
    }

}


const filterZoom = (data) => {
    let zoom = map.getZoom()
    let dataFiltered = []
    // let prop = parseInt(calcProporcao(zoom))
    let prop = calcProporcao(data.length, zoom)
    let propData = prop.proportionData
    // let propSize = prop.proportionSize
    let j = 0
    for (let i = 0; i < data.length; i = i + propData) {
        try {

            dataFiltered[j] = data[i]
        } catch (error) {
        }

        j++
    }
    return dataFiltered




}
const displayContents = async (table, contents, mapCellsInstancy) => {
    let zoom = map.getZoom()
    let bounds = JSON.stringify(map.getBounds())

    if (contents.info.request == 0) {
        requestAjaxCount++
        contents.info.request = 1;

        $.ajax({
            url: "/npsmart/map/get_data_from_files",
            method: 'POST',
            data: {
                latitude: contents.info.y,
                longitude: contents.info.x,
                table: table,
                bounds: bounds,
                zoom: zoom,
            },
            success: function (result) {
                requestAjaxCount--
                contents.info.request = 0;
                let info = {
                    data: JSON.parse(result),
                    name: table,
                    color: contents.info.color,

                }

                try {
                    removeLayerMap('newLayer', info, mapCellsInstancy);
                } catch (error) {
                    console.error('Erro ao remover camada:', error);
                }
                createPolygonLayer(info, '', 'newLayer', mapCellsInstancy)

                captureListState(mapCellsInstancy)

                setTimeout(function () {
                    if (requestAjaxCount == 0 && timeOutFlag) {
                        timeOutFlag = false
                        handleZoomMoveEnd(mapCellsInstancy)
                    }

                }, 2000);

            },

            error: function (error) {
                contents.info.request = 0;
                handleZoomMoveEnd(mapCellsInstancy)
                console.log((error))

            }
        });
    }



}


// Função para obter valores distintos de uma coluna pelo índice
function getDistinctValues(data, columnIndex) {
    var distinctValues = new Set();
    data.slice(1).forEach(row => { // Ignora o cabeçalho, por isso inicia de 1
        distinctValues.add(row[columnIndex]);
    });
    return Array.from(distinctValues);
}

var requestAjaxCount = 0;
var timeOutFlag = true;

function handleZoomMoveEnd(mapCellsInstancy) {
    console.log('handleZoomMoveEnd')

    for (let key in mapCellsInstancy.files) {

        let element = mapCellsInstancy.files[key];
        displayContents(key, element, mapCellsInstancy);

    }
}

function callAddLayerOnLayerControl(info, mapCellsInstancy) {
    addLayerOnLayerControl(info, mapCellsInstancy)
}

const createManageScreenLayerContent = (divManageScreenLayer, contents, mapCellsInstancy) => {

    let filePath = document.querySelector('#map-cells-choose-file').value
    let fileName = filePath.replace(/^.*[\\\/]/, '').replace(/\.[^/.]+$/, '').replace(/\s/g, '_');
    contents = encondingCotent(contents)

    mapCellsInstancy.files[fileName] = contents



    let encodingOptions = `
        <option value="utf-8">UTF-8</option>
        <option value="iso-8859-1">ISO-8859-1</option>
        <option value="windows-1252">Windows-1252</option>
    `
    let fileFormatOptions = `
    <label>
        <input type="checkbox" checked='true' name="fileFormatOption" value="csv">
        CSV (Comma Separeted Values)
    </label>
    <label>
        <input type="checkbox" name="fileFormatOption" value="regularExpression">
        Regular Expression
    </label>
    <label>
        <input type="checkbox" name="fileFormatOption" value="custom">
        Custom delimiters
    </label>
    `

    let fileFormatOptionsContent = `
        <div value ='regularExpression' class ='map-cells-file-format-set'>
            <div>
                <span>Expression:</span>
                <input type='text'>
            </div>
        </div>
        <div value ='custom' class ='map-cells-file-format-set'>
            <div>
                <input value='tab' type="checkbox">
                <span>Tab</span>
