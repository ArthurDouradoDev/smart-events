            <img class='map-cells-icon' src='/npsmart/images/arrow.png'>
        </div>
        <div class='map-cells-menu'>
            ${tab_menu_left}
            ${cards_menu_left}
            
        </div>
        <div class = 'map-cells-layer-control'>

            <div class ='map-cells-layer-control-title'>
            <apam>Layer Control</apam>
