const calculateDestinationMarkers = (startLatLng, azimuth, distance) => {
    var radius = 6371000; // Raio da Terra em metros
    var bearing = azimuth * Math.PI / 180; // Convertendo azimute para radianos

    var lat1 = startLatLng.lat * Math.PI / 180; // Convertendo latitude inicial para radianos
    var lon1 = startLatLng.lng * Math.PI / 180; // Convertendo longitude inicial para radianos

    var lat2 = Math.asin(Math.sin(lat1) * Math.cos(distance / radius) +
        Math.cos(lat1) * Math.sin(distance / radius) * Math.cos(bearing));

    var lon2 = lon1 + Math.atan2(Math.sin(bearing) * Math.sin(distance / radius) * Math.cos(lat1),
        Math.cos(distance / radius) - Math.sin(lat1) * Math.sin(lat2));

    lat2 = lat2 * 180 / Math.PI; // Convertendo latitude final para graus
    lon2 = lon2 * 180 / Math.PI; // Convertendo longitude final para graus

    return L.latLng(lat2, lon2);

}

const recarregarLayers = () => {
    // Salvar todos os layers atuais em um array
    var currentLayers = [];
    map.eachLayer(function (layer) {
        currentLayers.push(layer);
    });

    // Limpar todos os layers atuais do mapa
    currentLayers.forEach(function (layer) {
        map.removeLayer(layer);
    });

    // Adicionar novamente todos os layers salvos
    currentLayers.forEach(function (layer) {
        map.addLayer(layer);
    });
}

const createPolygonLayer = async (info, id, shape, mapInstancy) => {
    console.log('createPolygonLayer')
    if (!mapInstancy.files) mapInstancy.files = {};
    if (!mapInstancy.files[info.name]) {
        mapInstancy.files[info.name] = {
            info: {
                x: 'longitude',
                y: 'latitude',
                form: 'circle',
                size: 100,
                fillOpacity: 0.6,
                opacity: 1,
                color: info.color || '#3388ff'
            }
        };
    } 
    if (shape === 'petalMapCell') {
        if (info['azimuth'] != null && info['azimuth'] != undefined) {

            let angle = parseFloat(info['azimuth']);
            const startingPoint = { lat: info['latitude'], lng: info['longitude'] };
            let frequency_infos = mapInstancy.frequencies[info['tec']][info['frequency']]
            mapInstancy.cells[info['tec']][info['frequency']][id] = L.semiCircle(startingPoint, {
                radius: frequency_infos['radius'],
                fill: true,
                fillColor: frequency_infos['color'],
                fillOpacity: 0.5,
                color: frequency_infos['color'],
                opacity: 1,
                startAngle: angle + 20,
                stopAngle: angle - 20,
            }).addTo(map);
            mapInstancy.cells[info['tec']][info['frequency']][id].on('click', function (e) {
                var table = '<table class="map-cells-table-popup" border="1">';
                for (let key in info) {
                    if (info.hasOwnProperty(key)) {
                        let value = info[key];
                        table += '<tr><th>' + key + '</th><td>' + value + '</td></tr>'

                    }
                }
                table += '</table>';
                L.popup()
                    .setLatLng(e.latlng)
                    .setContent(table)
                    .openOn(map)
            })

        }
    }
    if (shape == 'mapCellsPropagationDelay') {
        const tec = info['tec'];
        const cell = info['cellname'];
        const start = parseInt(info['azimuth']) - 30;
        const end = parseInt(info['azimuth']) + 30;
        const latlong = [info['latitude'], info['longitude']]
        var latlng_for_markers = L.latLng(parseFloat(info['latitude']), parseFloat(info['longitude']));
        let azimuth = info['azimuth'];
        let color = "#000000"
        mapInstancy.propagationDelay[tec][cell] = []
        mapInstancy.propagationMarkers[tec][cell] = []
        let flag_orange_red = true;
        let den = parseInt(info['den'])
        for (let i = 0; i < mapInstancy.propagationDelayConsts[tec]['grid'].length; i++) {

            let percent_ta;


            if (tec == '3G') {
                percent_ta = ((parseFloat(info['tp' + i]) / parseFloat(info['sum_of_tps'])) * 100).toFixed(2)
            }
            if (tec == '4G') {
                percent_ta = ((parseFloat(info['l_ra_ta_ue_index' + i]) / parseFloat(info['sum_of_tas'])) * 100).toFixed(2)
            }
            if (tec == '5G') {
                percent_ta = ((parseFloat(info['n_ra_ta_ue_index' + i]) / parseFloat(info['sum_of_tas'])) * 100).toFixed(2)
            }
            if (percent_ta <= 3) {
                color = mapInstancy.propagationDelayConsts['colors']['green'];

            } else if (percent_ta <= 5) {
                color = mapInstancy.propagationDelayConsts['colors']['yellow'];


            } else if (percent_ta <= 15) {
                color = mapInstancy.propagationDelayConsts['colors']['orange']
                flag_orange_red = false
            } else if (percent_ta <= 30) {
                color = mapInstancy.propagationDelayConsts['colors']['dark_orange']
                flag_orange_red = false
            }
            else {
                color = mapInstancy.propagationDelayConsts['colors']['red']
                flag_orange_red = false
            }
            let percent_flag = false
            for (let j = i; j < mapInstancy.propagationDelayConsts[tec]['grid'].length; j++) {
                if (tec == '3G') {
                    if ((parseFloat(info['tp' + j])) != 0) {
                        percent_flag = true
                    }
                }
                if (tec == '4G') {
                    if ((parseFloat(info['l_ra_ta_ue_index' + j])) != 0) {
                        percent_flag = true
                    }
                }
                if (tec == '5G') {
                    if ((parseFloat(info['n_ra_ta_ue_index' + j])) != 0) {
                        percent_flag = true
                    }
                }

            }
            if (percent_flag) {
                if (i == 0) {
                    let radius = ''
                    // if (tec == '5G') {
                    //     radius = mapInstancy.propagationDelayConsts[tec]['grid'][i] / den
                    // } else {
                        radius = mapInstancy.propagationDelayConsts[tec]['grid'][i]
                    // }

                    mapInstancy.propagationDelay[tec][cell][i] = L.semiCircle(latlong, {
                        radius: radius,
                        fill: true,
                        fillColor: color,
                        fillOpacity: 0.7,
                        color: '#000000',
                        opacity: 0.7,
                        startAngle: start,
                        stopAngle: end,
                        percent: percent_ta,
                    }).addTo(map);
                } else {
                    mapInstancy.propagationDelay[tec][cell][i] = L.semiCircle(latlong, {
                        innerRadius: mapInstancy.propagationDelayConsts[tec]['grid'][i - 1],
                        radius: mapInstancy.propagationDelayConsts[tec]['grid'][i],
                        fill: true,
                        fillColor: color,
                        fillOpacity: 0.7,
                        color: '#000000',
                        opacity: 0.7,
                        startAngle: start,
                        stopAngle: end,
                        percent: percent_ta,
                    }).addTo(map);
                }

                mapInstancy.propagationDelay[tec][cell][i].bringToBack()


                var latlngFinal = calculateDestinationMarkers(latlng_for_markers, azimuth, mapInstancy.propagationDelayConsts[tec]['grid_markers'][i]);
                mapInstancy.propagationMarkers[tec][cell][i] = L.marker(latlngFinal, {
                    icon: L.divIcon({
                        className: 'labelClass',
                        html: '<div class ="map-cell-propagation-label" title="' + info['dateday'] + '">' + percent_ta + '%' + '</div>'
                    })
                }).addTo(map);


            } else {
                mapInstancy.propagationDelay[tec][cell][i] = L.semiCircle(latlong, {
                    radius: mapInstancy.propagationDelayConsts[tec]['grid'][i],
                    fill: false,
                    fillColor: '#00000000',
                    fillOpacity: 0.5,
                    color: '#00000000',
                    opacity: 0.5,
                    startAngle: start,
                    stopAngle: end
                }).addTo(map);
            }
        }
        mapInstancy.propagationDelay[tec][cell][mapInstancy.propagationDelayConsts[tec]['grid'].length] = L.semiCircle(latlong, {
            radius: parseInt(info['grid']),
            fill: false,
            color: '#FFFFFF',
            opacity: 1,
            startAngle: start,
            stopAngle: end
        }).addTo(map);
        mapInstancy.propagationDelay[tec][cell][mapInstancy.propagationDelayConsts[tec]['grid'].length].bringToFront()

    }
    if (shape == 'mapCellsOoklaDots') {

        for (let i = 0; i < info.length; i++) {

            let title = ''
            let vel = parseFloat(info[i]['DL Speed (Mbps)']);
            let color = '#FFFFFF'
            if (info[i]['technology'] == '4G') {
                if (vel < 5) {
                    color = '#ff0101'
                    title = 'A'
                } else if (vel < 15) {
                    color = '#ffc0cc'
                    title = "B"
                } else if (vel < 30) {
                    color = '#fefd02'
                    title = 'C'
                } else if (vel < 45) {
                    color = '#00ff03'
                    title = 'D'
                } else {
                    color = '#0473ff'
                    title = 'E'
                }
            }
            if (info[i]['technology'] == '5G') {

                if (vel < 100) {
                    color = '#ff0101'
                    title = 'A'
                } else if (vel < 200) {
                    color = '#ffc0cc'
                    title = "B"

                } else if (vel < 300) {
                    color = '#fefd02'
                    title = 'C'

                } else if (vel < 400) {
                    color = '#00ff03'
                    title = 'D'

                } else {
                    color = '#0473ff'
                    title = 'E'

                }
            }

            const latlong = [info[i]['latitude'], info[i]['longitude']]
            mapInstancy.ooklaDotsLayers[info[i]['technology']] = []
            mapInstancy.ooklaDotsLayers[info[i]['technology']][i] = L.semiCircle(latlong, {
                radius: 60,
                fill: true,
                fillColor: color,
                fillOpacity: 0.5,
                color: color,
                opacity: 1,
                startAngle: 0,
                stopAngle: 360,
                title: title,
                value: 1,
                maxValue: 1
            })

            mapInstancy.ooklaDots[info[i]['technology']].addLayer(mapInstancy.ooklaDotsLayers[info[i]['technology']][i].on('click', function (e) {
                var info_table = '<table class="map-cells-table-popup" border="1">';

                for (let key in info[i]) {
                    if (info[i].hasOwnProperty(key)) {

                        let value = info[i][key];
                        info_table += '<tr><th>' + key + '</th><td>' + value + '</td></tr>'

                    }
                }
                info_table += '</table>';
                L.popup()
                    .setLatLng(e.latlng)
                    .setContent(info_table)
                    .openOn(map)
                e.stopPropagation();
            })
            )




        }
        map.addLayer(mapInstancy.ooklaDots[info[0]['technology']]);
    }
    if (shape == 'newLayer') {
        let iconVisibility = document.querySelector(`.map-cells-icon-change-visibility[layername="${info.name}"]`);
        let layerVisible = true;
        if (iconVisibility.getAttribute('src') == '/npsmart/images/visible.png') {
            layerVisible = false
        }
        let longitude = mapInstancy.files[info.name]['info']['x']
        let latitude = mapInstancy.files[info.name]['info']['y'];
        if (!mapInstancy.layerFiles[info.name]) {
            mapInstancy.layerFiles[info.name] = L.layerGroup();
        } else {
            mapInstancy.layerFiles[info.name].clearLayers(); // Limpa os marcadores existentes, se houver
        }
        let size = (mapInstancy.files[info.name].info.size !== undefined) ? mapInstancy.files[info.name].info.size : 10
        let fillOpacity = (mapInstancy.files[info.name].info.fillOpacity !== undefined) ? mapInstancy.files[info.name].info.fillOpacity : 0.5
        let opacity = (mapInstancy.files[info.name].info.opacity !== undefined) ? mapInstancy.files[info.name].info.opacity : 1
        let form = (mapInstancy.files[info.name].info.form !== undefined) ? mapInstancy.files[info.name].info.form : 'circle'
        let color = info.color
        for (let i = 0; i < info.data.length; i++) {

            if (info.data[i][latitude] != undefined && info.data[i][longitude] != undefined) {
                let startingPoint = { lat: info.data[i][latitude], lng: info.data[i][longitude] };

                let metersToDegreesLat = 1 / 111320;
                let metersToDegreesLng = metersToDegreesLat * Math.cos(startingPoint.lat * Math.PI / 180);

                let halfSizeInDegreesLat = (size / 2) * metersToDegreesLat;
                let halfSizeInDegreesLng = (size / 2) * metersToDegreesLng;

                let columnRef = mapInstancy.files[info.name].info.columnRef

                let marker;
                if (columnRef != null) {
                    let type = mapInstancy.files[info.name].info.classifyType
                    switch (type) {
                        case "distinct":
                            try {
                                size = mapInstancy.files[info.name].info.categories[info.data[i][columnRef]].size
                                fillOpacity = mapInstancy.files[info.name].info.categories[info.data[i][columnRef]].fillOpacity
                                opacity = mapInstancy.files[info.name].info.categories[info.data[i][columnRef]].opacity
                                color = mapInstancy.files[info.name].info.categories[info.data[i][columnRef]].color

                            } catch (error) {
                                console.error(error)
                            }
                            break;
                        case "range":
                            let mapInfoRanges = mapInstancy.files[info.name].info.categories
                            for (let j = 0; j < mapInfoRanges.length; j++) {
                                if (mapInfoRanges[j]['min'] == '-inf') {

                                    if (mapInfoRanges[j]['max'] != '+inf') {
                                        if (parseFloat(info.data[i][columnRef]) < parseFloat(mapInfoRanges[j]['max'])) {
                                            size = mapInfoRanges[j].size
                                            fillOpacity = mapInfoRanges[j].fillOpacity
                                            opacity = mapInfoRanges[j].opacity
                                            color = mapInfoRanges[j].color
                                            break;
                                        }

                                    } else {
                                        size = mapInfoRanges[j].size
                                        fillOpacity = mapInfoRanges[j].fillOpacity
                                        opacity = mapInfoRanges[j].opacity
                                        color = mapInfoRanges[j].color
                                        break
                                    }
                                } else if (mapInfoRanges[j]['max'] == '+inf') {
                                    if (parseFloat(info.data[i][columnRef]) >= parseFloat(mapInfoRanges[j]['min'])) {
                                        size = mapInfoRanges[j].size
                                        fillOpacity = mapInfoRanges[j].fillOpacity
                                        opacity = mapInfoRanges[j].opacity
                                        color = mapInfoRanges[j].color
                                        break;
                                    }
                                } else {
                                    if (parseFloat(info.data[i][columnRef]) >= parseFloat(mapInfoRanges[j]['min']) && parseFloat(info.data[i][columnRef]) < parseFloat(mapInfoRanges[j]['max'])) {
                                        size = mapInfoRanges[j].size
                                        fillOpacity = mapInfoRanges[j].fillOpacity
                                        opacity = mapInfoRanges[j].opacity
                                        color = mapInfoRanges[j].color
                                        break;
                                    }
                                }
                            }
                            break;
                        default:
                            break;
                    }

                }
                switch (form) {
                    case 'circle':
                        marker = L.semiCircle(startingPoint, {
                            radius: size,
                            fill: true,
                            fillColor: color,
                            fillOpacity: layerVisible ? fillOpacity : 0,
                            color: color,
                            opacity: layerVisible ? opacity : 0,
                            startAngle: 0,
                            stopAngle: 360,
                            value: 1,
                            maxValue: 1
                        })
                        break;
                    case 'square':
                        marker = L.rectangle([
                            [parseFloat(startingPoint.lat) - halfSizeInDegreesLat, parseFloat(startingPoint.lng) - halfSizeInDegreesLng],
                            [parseFloat(startingPoint.lat) + halfSizeInDegreesLat, parseFloat(startingPoint.lng) + halfSizeInDegreesLng]
                        ], {
                            color: color,
                            weight: 1,
                            fillOpacity: layerVisible ? fillOpacity : 0,
                            opacity: layerVisible ? opacity : 0
                        });
                        break;

                    case 'diamond':
                        let diamondSizeInDegrees = size / Math.sqrt(2) * metersToDegreesLat;
                        marker = L.polygon([
                            [parseFloat(startingPoint.lat), parseFloat(startingPoint.lng) - diamondSizeInDegrees],
                            [parseFloat(startingPoint.lat) + diamondSizeInDegrees, parseFloat(startingPoint.lng)],
                            [parseFloat(startingPoint.lat), parseFloat(startingPoint.lng) + diamondSizeInDegrees],
                            [parseFloat(startingPoint.lat) - diamondSizeInDegrees, parseFloat(startingPoint.lng)]
                        ], {
                            color: color,
                            weight: 1,
                            fillOpacity: layerVisible ? fillOpacity : 0,
                            opacity: layerVisible ? opacity : 0
                        });
                        break;

                    case 'cone':
                        console.log('entrei no cone')
                        console.log(mapInstancy.files[info.name].info.z)
                        console.log(info.data[i][mapInstancy.files[info.name].info.z])
                        marker =  L.semiCircle(startingPoint, {
                            radius: size,
                            fill: true,
                            fillColor: color,
                            fillOpacity: layerVisible ? fillOpacity : 0,
                            color: color,
                            opacity: layerVisible ? opacity : 0,
                            startAngle: parseFloat(info.data[i][mapInstancy.files[info.name].info.z]) + parseFloat(mapInstancy.files[info.name].info.apertureAngle),
                            stopAngle: parseFloat(info.data[i][mapInstancy.files[info.name].info.z]) - parseFloat(mapInstancy.files[info.name].info.apertureAngle),
                        })
                        break;
                    default:
                        break;
                }
                // console.log(mapInstancy.files[info.name].info.labelHeader)
                let labels = mapInstancy.files[info.name].info.labelHeader ?? []
                addPopUpClickNewLayer(marker, info.data[i], labels)
                marker.addTo(mapInstancy.layerFiles[info.name])
            }

        }
        map.addLayer(mapInstancy.layerFiles[info.name])
        recarregarLayers()
        // mapInstancy.layerFiles[info.name].addTo(map);
    }

};

const addPopUpClickNewLayer = (marker, data, label=[]) =>{
    marker.on('click', function (e) {
        var info_table = '<table class="map-cells-table-popup" border="1">';

        if(label.length != 0){
            for(let i = 0; i < label.length; i++){
                if(data.hasOwnProperty(label[i])){
                    let value = data[label[i]];
                    info_table += '<tr><th>' + label[i] + '</th><td>' + value + '</td></tr>'
                }
            }
        }
        else{
            for (let key in data) {
                if (data.hasOwnProperty(key)) {
    
                    let value = data[key];
                    info_table += '<tr><th>' + key + '</th><td>' + value + '</td></tr>'
    
                }
            }
        }
        info_table += '</table>';
        L.popup()
            .setLatLng(e.latlng)
            .setContent(info_table)
            .openOn(map)
        e.originalEvent.stopPropagation();
    })
}

const removeLayerMap = async (layer, layers_to_remove, mapInstancy) => {
    if (layer == 'petalMapCell') {
        if (layers_to_remove.frequency != undefined) {
            mapInstancy.cells[layers_to_remove['tec']][layers_to_remove['frequency']].forEach(element => {
                map.removeLayer(element)
            })
        } else {
            try {
                mapInstancy.cells[layers_to_remove['tec']].forEach(element => {
                    element.forEach(element1 => {
                        map.removeLayer(element1)
                    })
                })
            } catch (error) {
                console.log(error)
            }

        }

    }
    if (layer == 'mapCellsPropagationDelay') {
        for (let key in mapInstancy.propagationDelay[layers_to_remove['tec']]) {
            for (let i = 0; i < mapInstancy.propagationDelay[layers_to_remove['tec']][key].length; i++) {
                map.removeLayer(mapInstancy.propagationDelay[layers_to_remove['tec']][key][i])

            }
        }
        for (let key in mapInstancy.propagationMarkers[layers_to_remove['tec']]) {
            for (let i = 0; i < mapInstancy.propagationMarkers[layers_to_remove['tec']][key].length; i++) {
                try {
                    map.removeLayer(mapInstancy.propagationMarkers[layers_to_remove['tec']][key][i])
                } catch (error) {

                }

            }
        }
    }
    if (layer == 'mapCellsOoklaDots') {
        map.removeLayer(mapInstancy.ooklaDots[layers_to_remove['tec']])
        mapInstancy.ooklaDots[layers_to_remove['tec']].clearLayers()
    }
    if (layer == 'newLayer') {
        map.removeLayer(mapInstancy.layerFiles[layers_to_remove.name]);
        delete mapInstancy.layerFiles[layers_to_remove.name];

    }
}
const show_hide_subtitle_layer = (info) => {
    if (info.layer != 'petalMapCell' && info.layer != 'mapCellsOoklaDots') {
        info.tec = undefined
    }

    if (info.layer != 'newLayer') {
        if (info.tec != undefined) {
            if (info.checked) {
                document.querySelector(`#subtitle-${info.layer}${info.tec}`).style.display = 'block'

            }
            else {
                document.querySelector(`#subtitle-${info.layer}${info.tec}`).style.display = 'none'

            }
        }
        else {
            if (info.checked) {
                document.querySelector(`#subtitle-${info.layer}`).style.display = 'block'

            }
            else {
                document.querySelector(`#subtitle-${info.layer}`).style.display = 'none'
            }
        }
    } else {
        if (info.checked) {
            console.log(info)
            document.querySelector(`div.map-cells-file-subtitle[layername="${info.layername}"]`).style.display = 'flex'

        }
        else {
            document.querySelector(`div.map-cells-file-subtitle[layername="${info.layername}"]`).style.display = 'none'

        }
    }


}

const add_subtitle_file_layer = (files) => {
    let subtitlesDivs = ''

    for (const [layer, values] of Object.entries(files)) {
        if (values.info.classifyType != undefined) {
            let content = '';

            let inputsubtitle = document.querySelector(`input[layername="${values.info.layerNameData}"]`);
            switch (values.info.classifyType) {
                case 'distinct':
                    inputsubtitle.closest('.map-cells-draggable-item-content-subtitle').style.display = 'inline'
                    for (const [type, info] of Object.entries(values.info.categories)) {
                        content += `<div class='map-cells-file-subtitle-content-row'>
                            <div class = 'map-cells-file-subtitle-content-row-color' style="background-color: ${info.color};"></div>
                            <span>${type}</span>
                        </div>`
                    }

                    break;

                case 'range':
                    inputsubtitle.closest('.map-cells-draggable-item-content-subtitle').style.display = 'inline'

                    for (const [type, info] of Object.entries(values.info.categories)) {
                        content += `<div class='map-cells-file-subtitle-content-row'>
                            <div class = 'map-cells-file-subtitle-content-row-color' style="background-color: ${info.color};"></div>
                            <span>${info.min} ~ ${info.max} </span>
                        </div>`
                    }

                    break;
                default:

                    inputsubtitle.closest('.map-cells-draggable-item-content-subtitle').style.display = 'inline'
                    break;
            }

            subtitlesDivs += `
                    <div class = 'map-cells-file-subtitle' layerName ='${layer}'>
                        <div class = 'map-cells-file-subtitle-title'>
                            <span> ${values.info.layerName} </span>
                        </div>
                        <div class = 'map-cells-file-subtitle-title-column'>
                            <span> ${values.info.columnRef} </span>
                        </div>
                        <div class = 'map-cells-file-subtitle-content'>
                            ${content}
                        </div>
                    </div>
                `
        }



    }


    document.querySelector('.map-cells-card-files-subtitles').innerHTML = subtitlesDivs

}

const chageLayerVisibility = (info, mapInstancy, remove) => {
    switch (info.layer) {
        case 'petalMapCell':
            try {
                mapInstancy.cells[info['tec']].forEach(element => {
                    element.forEach(element1 => {
                        element1.setStyle({
                            opacity: remove ? 0 : 1,
                            fillOpacity: remove ? 0 : 0.5
                        });
                    })
                })
            } catch (error) {
                console.log(error)
            }
            break;

        case 'mapCellsPropagationDelay':
            for (let key in mapInstancy.propagationDelay[info['tec']]) {
                for (let i = 0; i < mapInstancy.propagationDelay[info['tec']][key].length; i++) {
                    mapInstancy.propagationDelay[info['tec']][key][i].setStyle({
                        opacity: remove ? 0 : 1,
                        fillOpacity: remove ? 0 : 0.7
                    });

                }
            }
            if (remove) {
                $(".map-cell-propagation-label").css('display', 'none')
            } else {
                $(".map-cell-propagation-label").css('display', 'block')

            }
            break;

        case 'mapCellsOoklaDots':
            if (remove) {
                $('.donut-cluster').css('display', 'none')
            } else {
                $('.donut-cluster').css('display', 'block')
            }
            mapInstancy.ooklaDots[info['tec']].eachLayer(element => {
                element.setStyle({
                    opacity: remove ? 0 : 1,
                    fillOpacity: remove ? 0 : 0.5
                });
            })

            break;

        case 'newLayer':
            // mapInstancy.files[info.name].info.opacity
            let opacity = mapInstancy.files[info.name].info.opacity ?? 1
            let fillOpacity = mapInstancy.files[info.name].info.fillOpacity ?? 0.5
            mapInstancy.layerFiles[info.name].eachLayer(element => {
                element.setStyle({
                    opacity: remove ? 0 : opacity,
                    fillOpacity: remove ? 0 : fillOpacity
                });
            })

            break;
        default:
            break;
    }
}

const blockUi = (plot, mapCellsInstancy) => {
    if (plot) {
        var divAtual = document.querySelector(`#${mapCellsInstancy.id}`);

        var divExistente = divAtual.querySelector('.map-cells-card-block');

        if (!divExistente) {
            var divNova = document.createElement("div");
            divNova.classList.add('map-cells-card-block');
            divNova.style.backgroundColor = 'rgba(0,0,0,0.35)';

            divAtual.append(divNova);

            $('.map-cells-menu').css({
                'filter': 'blur(3px)'
            });
            $('.map-cells-layer-control').css({
                'filter': 'blur(3px)'
            });
            $('.map-cells-card-subtitle').css({
                'filter': 'blur(3px)',
                'pointer-events': 'none'
            });
        }
    } else {
        try {
            var divRemove = document.querySelector('.map-cells-card-block')
            divRemove.parentNode.removeChild(divRemove)
            $('.map-cells-menu').css({
                'filter': 'blur(0px)'
            })
            $('.map-cells-layer-control').css({
                'filter': 'blur(0px)'
            })
            $('.map-cells-card-subtitle').css({
                'filter': 'blur(0px)',
                'pointer-events': 'all'
            })
        } catch (error) {

        }
    }
}

const callCellDataBySubtitles = (data, mapCellsInstancy) => {
    blockUi(true, mapCellsInstancy)

    data.state = data.state.toString();
    data.city = data.city.toString();
    data.station = data.station.toString();
    data.cell = data.cell.toString();
    $.ajax({
        url: "/npsmart/map/show_petals",
        method: 'POST',
        data: data,
        success: function (result) {

            result = JSON.parse(result)
            for (let i = 0; i < result.length; i++) {

                result[i].tec = data.tec

                createPolygonLayer(result[i], i, 'petalMapCell', mapCellsInstancy)
                blockUi(false, mapCellsInstancy)
            }

            orderLayer({
                layer: 'petalMapCell',
                tec: data.tec
            }, mapCellsInstancy)


        },

        error: function (error) {
            Swal.fire({
                title: 'Error!',
                text: 'Error when getting data',
                icon: 'error',
                confirmButtonText: 'Ok'
            })

        }
    });
}

const captureListState = (mapCellsInstancy) => {
    const itemsList = document.querySelectorAll('.map-cells-draggable-item');
    const reversedItems = Array.from(itemsList).reverse();
    reversedItems.forEach(item => {
        orderLayer({
            layer: item.getAttribute('layer'),
            tec: item.getAttribute('tech'),
            name: item.getAttribute('layerName')
        }, mapCellsInstancy)
    });
}

const orderLayer = (info, mapInstancy) => {

    if (info.layer == 'petalMapCell') {


        const freqKeys = Object.keys(mapInstancy.frequencies[info.tec])
        for (const frequency of freqKeys) {

            mapInstancy.cells[info.tec][frequency].forEach(element => {
                element.bringToFront()
            })

        }

    }
    if (info.layer == 'mapCellsPropagationDelay') {
        for (let key in mapInstancy.propagationDelay[info.tec]) {
            mapInstancy.propagationDelay[info.tec][key].forEach(element => {

                element.bringToFront()
            })
        }

    }
    if (info.layer == 'mapCellsOoklaDots') {
        mapInstancy.ooklaDots['4G'].getLayers().forEach(element => {
            element.bringToFront()
        })

    }
    if (info.layer == 'newLayer') {

        mapInstancy.layerFiles[info.name].getLayers().forEach(element => {
            element.bringToFront()
        })

    }
}
const location_to = (latitude, longitude, mapInstancy) => {
    map.flyTo([latitude, longitude], 17, {
        duration: 2
    });
}

const addLayerOnLayerControl = (info, mapCellsInstancy) => {
    const clickable = info.clickable ?? null;
    let divLayerControl = document.querySelector('.map-cells-layer-control-content')


    let draggableItems = document.querySelectorAll('.map-cells-draggable-item')
    let layerNotExist = true


    let layerTitleCount = 0

    draggableItems.forEach(element => {
        if (info.layer == 'newLayer') {
            if (info.layer == element.getAttribute('layer')) {
                if (info.layerNameData == element.getAttribute('layerName')) {
                    layerNotExist = false
                } else if (info.layerName == element.getAttribute('layerTitle')) {
                    layerTitleCount++
                }
            }
        } else {
            if (element.getAttribute('tech') == info.tec && info.layer == element.getAttribute('layer')) {
                layerNotExist = false
            }
        }

    })
    let layerTitle = ``;
    if (layerTitleCount > 0) {
        layerTitle = `
        (${layerTitleCount})
        `
    }
    if (layerNotExist) {
        let newLayerControlItem;
        if (info.layer != 'newLayer') {
            newLayerControlItem = `
                <div tech = '${info.tec}'  draggable="true" layer=${info.layer} class ='map-cells-draggable-item'>
                    <div class= 'map-cells-draggable-item-content'>
                       
                        <div class= 'map-cells-draggable-item-content-title'>
                                
                                <img layer=${info.layer}  tech = '${info.tec}' class='map-cells-icon-change-visibility' src ='/npsmart/images/visibility.png'> 
                                ${info.tec} ${info.layer} Layer
                        </div>
                        <div class= 'map-cells-draggable-item-content-subtitle'>
                                
                            <input type='checkbox' checked tech = '${info.tec}' layer=${info.layer}> 
                            <span>Subtitles</span>
                        </div>
                    </div>
                    <div tech = '${info.tec}'  layer=${info.layer} class= 'map-cells-draggable-item-close'>
                        <img src ='/npsmart/images/icon-close.png'>
                    </div>
                </div>
            `
        } else {
            newLayerControlItem = `
            <div  draggable="true" layer=${info.layer} layerName = '${info.layerNameData}' layerTitle= '${info.layerName}' clickable='${info.clickable}' class ='map-cells-draggable-item'>
                    <div class= 'map-cells-draggable-item-content'>
                        <div class= 'map-cells-draggable-item-content-title'>
                                <img layer=${info.layer} layerName = '${info.layerNameData}' class='map-cells-icon-change-visibility' src ='/npsmart/images/visibility.png'> 
                                ${info.layerName}${layerTitle} Layer
                        </div>
                        <div class= 'map-cells-draggable-item-content-subtitle' style="display: none;">
                                
                            <input type='checkbox' checked layername= '${info.layerNameData}' layer='${info.layer}'  > 
                            <span>Subtitles</span>
                        </div>
                    </div>
                    <div  layer=${info.layer} layerName = '${info.layerNameData}' class= 'map-cells-draggable-item-close'>
                        <img src ='/npsmart/images/icon-close.png'>
                    </div>
                </div>
            `
        }

        divLayerControl.innerHTML = newLayerControlItem + divLayerControl.innerHTML
    }


    info.checked = true
    if (info.layer != 'newLayer') {
        show_hide_subtitle_layer(info)

    }

    let items = document.querySelectorAll('.map-cells-draggable-item');
    items.forEach(item => {
        item.removeEventListener('dblclick', function () {
            if(this.getAttribute('layer')=='newLayer' && this.getAttribute('clickable') != 'false'){
                callEditLayer(item, mapCellsInstancy)
                blockUi(true, mapCellsInstancy)
            }
           
        })
        item.addEventListener('dblclick', function () {
            if(this.getAttribute('layer')=='newLayer' && this.getAttribute('clickable') !=  'false'){
                callEditLayer(item, mapCellsInstancy)
                blockUi(true, mapCellsInstancy)
            }else{
                this.setAttribute('clickable', "false")
            }
        })
    })
    let draggedItem = null;
    // let dropIndicator = null; // Variável para armazenar o indicador visual
    let dropIndicator = document.createElement('div');
    dropIndicator.className = 'drop-indicator';
    dropIndicator.style.height = '4px';
    dropIndicator.style.background = '#007bff';
    dropIndicator.style.margin = '2px 0';

    items.forEach(item => {
        item.addEventListener('dragstart', function () {
            draggedItem = item;
            setTimeout(function () {
                item.style.display = 'none';
            }, 0);
        });

        item.addEventListener('dragend', function () {
            setTimeout(function () {
                draggedItem.style.display = 'flex';
                draggedItem = null;
                // Remove o indicador visual ao finalizar o arrasto
                if (dropIndicator && dropIndicator.parentNode) {
                    dropIndicator.parentNode.removeChild(dropIndicator);
                    dropIndicator = null;
                }
                // Após o drag end, captura o estado atual da lista

            }, 0);
        });

        item.addEventListener('dragover', function (e) {
            e.preventDefault();
        });

        item.addEventListener('dragenter', function (e) {
            e.preventDefault();
            this.style.backgroundColor = '#f7f7f7';
        });

        item.addEventListener('dragleave', function () {
            this.style.backgroundColor = '#f0f0f0';
        });

        item.addEventListener('drop', function (e) {
            e.preventDefault();
            this.style.backgroundColor = '#f0f0f0';

            if (draggedItem !== null) {
                // Verifica se o draggedItem é diferente do item atual
                if (draggedItem !== this) {
                    const parent = this.parentNode;
                    parent.insertBefore(draggedItem, this); // Insere o draggedItem antes do item atual
                }

                // Remove o indicador visual ao soltar o item
                if (dropIndicator && dropIndicator.parentNode) {
                    dropIndicator.parentNode.removeChild(dropIndicator);
                    dropIndicator = null;
                }

                // Após o drop, captura o estado atual da lista
                captureListState(mapCellsInstancy);
            }
        });
    });




    let inputs = document.querySelectorAll('.map-cells-draggable-item-content-subtitle input')
    inputs.forEach(element => {

        element.addEventListener('change', function () {

            let info = {
                layer: element.getAttribute('layer'),
                tec: element.getAttribute('tech'),
                layername: element.getAttribute('layername')
            }
            if (this.checked) {
                info.checked = true
                show_hide_subtitle_layer(info)
            } else {
                info.checked = false
                show_hide_subtitle_layer(info)
            }
        });
    })





    let closeButtons = document.querySelectorAll('.map-cells-draggable-item-close')
    closeButtons.forEach(element => {
        element.addEventListener('click', function () {

            let infoElement = {
                layer: element.getAttribute('layer'),
                tec: element.getAttribute('tech'),
                name: element.getAttribute('layerName')

            }
            infoElement.checked = false
            removeLayerMap(element.getAttribute('layer'), infoElement, mapCellsInstancy)
            delete mapCellsInstancy.files[infoElement.name]

            if (info.layer != 'newLayer') {
                show_hide_subtitle_layer(infoElement)

            } {
                add_subtitle_file_layer(mapCellsInstancy.files)
            }


            let elementoPai = element.closest('.map-cells-draggable-item');
            if (elementoPai) {
                elementoPai.remove();
            }
            if(element.getAttribute('layer') != 'newLayer'){
                document.querySelector(`#map-cells-control-panel-select-uf${element.getAttribute('tech')}`).reset()
            }

        })
    })

    document.querySelectorAll('.map-cells-icon-change-visibility').forEach(element => {

        element.addEventListener('click', function () {
            let info = {
                layer: element.getAttribute('layer'),
                tec: element.getAttribute('tech'),
                name: element.getAttribute('layerName'),
            }
            if (element.getAttribute('src') == '/npsmart/images/visibility.png') {
                element.setAttribute('src', '/npsmart/images/visible.png')


                chageLayerVisibility(info, mapCellsInstancy, true)
            } else {
                element.setAttribute('src', '/npsmart/images/visibility.png')
                chageLayerVisibility(info, mapCellsInstancy, false)
            }
        })
    })

}

const callOoklaData = (tech, mapCellsInstancy) => {

    let date = $(`#dateRangePicker${tech['tec']}`).val()
    virtual_select_option_ookla = $(`#map-cells-ookla-select-uf${tech['tec']}`).val()
    let selected_velocities = []

    if (mapCellsInstancy.menus.right != undefined) {
        document.querySelectorAll(`#subtitle-mapCellsOoklaDots${tech['tec']}`).forEach(function (element) {
            let subtitle = element.querySelectorAll('.map-cells-subtitle-info');
            subtitle.forEach(function (sub) {
                if (sub.getAttribute("selected") == "true") {
                    selected_velocities.push(sub.getAttribute("value"))
                }
            })
        })
    }

    if (virtual_select_option_ookla.length != 0) {
        $.ajax({
            url: "/npsmart/map/call_ookla_data",
            method: 'POST',
            data: {
                uf: virtual_select_option_ookla,
                tech: tech['tec'],
                selected_velocities: selected_velocities,
                data: date,
            },
            success: function (result) {

                result = JSON.parse(result)
                createPolygonLayer(result, '', 'mapCellsOoklaDots', mapCellsInstancy)

                addLayerOnLayerControl({
                    tec: tech['tec'],
                    layer: 'mapCellsOoklaDots',
                }, mapCellsInstancy)
            },

            error: function (error) {
                Swal.fire({
                    title: 'Error!',
                    text: 'Error when getting data',
                    icon: 'error',
                    confirmButtonText: 'Ok'
                })
            }
        });
    }

}

const colorHexa = () => {
    // Gerar componentes de cor aleatórios
    const r = Math.floor(Math.random() * 256); // Vermelho (0-255)
    const g = Math.floor(Math.random() * 256); // Verde (0-255)
    const b = Math.floor(Math.random() * 256); // Azul (0-255)

    // Converter para formato hexadecimal
    const hexR = r.toString(16).padStart(2, '0'); // Converter para hexadecimal e garantir que tenha dois dígitos
    const hexG = g.toString(16).padStart(2, '0');
    const hexB = b.toString(16).padStart(2, '0');

    // Formatar a cor no formato '#RRGGBB'
    const corHex = `#${hexR}${hexG}${hexB}`;

    return corHex;
}
const createCustomRoute = (lat, long, label = 'newLayer') => {
    const customLayer = L.layerGroup();

    const circle = L.circle([lat, long], {
        color: 'blue',
        radius: 40,
        fillOpacity: 1,
    });

    customLayer.addLayer(circle);
 
    map.addLayer(customLayer);

    console.log('Custom layer adicionada:', customLayer);

    recarregarLayers()

    addLayerOnLayerControl({
        layer: 'newLayer',
        layerName: 'newLayer',
        layerNameData: 'newLayer'
    }, map);
}

