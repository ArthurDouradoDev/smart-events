};

const removeCustomLayers = (layerName, mapInstancy) => {
    if(typeof mapInstancy.layerFiles[layerName] !== 'undefined'){
        removeLayerMap('newLayer', 
        {
            "layer": "newLayer",
            "tec": null,
            "name": layerName,
            "checked": false
        }, mapInstancy)
        delete mapInstancy.files[layerName]
        add_subtitle_file_layer(mapInstancy.files)

        let closeButtons = document.querySelectorAll('.map-cells-draggable-item-close')
        let element = Array.from(closeButtons).filter(ele => ele.getAttribute('layername') === layerName)[0]
        let elementoPai = element.closest('.map-cells-draggable-item');
        if (elementoPai) {
            elementoPai.remove();
        }
    }

}

const saveInstancy = (mapInstancy) => {
    const map = mapInstancy.map;

    // pega o elemento do layer control correspondente
    const findLayerControlItem = (info) => {
        if (!document) return null;
        const all = document.querySelectorAll('.map-cells-draggable-item');
        for (const el of all) {
            const layerAttr = el.getAttribute('layer');
            const layerNameAttr = el.getAttribute('layerName');
            const techAttr = el.getAttribute('tech');
            if (info.layer === 'newLayer') {
                if (layerAttr === 'newLayer' && layerNameAttr === info.name) return el;
            } else {
                if (layerAttr === info.layer && techAttr === info.tec) return el;
            }
        }
        return null;
    };

    // lê ícone do "olho" do item do layer control
    const isEyeOpenFromControl = (controlItem) => {
        if (!controlItem) return false;
        const img = controlItem.querySelector('.map-cells-icon-change-visibility');
        if (!img) return true; // se não há ícone, assumir visível por compatibilidade
        return img.getAttribute('src') === '/npsmart/images/visibility.png';
    };

    // verifica se um Leaflet layer/group está presente no mapa
    const isOnMap = (leafletLayer) => {
        try {
            return leafletLayer && map && map.hasLayer && map.hasLayer(leafletLayer);
        } catch (e) {
            return false;
        }
    };

    // tenta inferir se a camada tem opacidade > 0 (se aplicável)
    const hasNonZeroOpacity = (leafletLayer) => {
        if (!leafletLayer) return false;
        // para LayerGroup, verifica qualquer sublayer
        if (leafletLayer.getLayers && typeof leafletLayer.getLayers === 'function') {
            const layers = leafletLayer.getLayers();
            for (const l of layers) {
                if (l.options) {
                    const o = l.options;
                    if ((o.opacity === undefined || o.opacity > 0) || (o.fillOpacity === undefined || o.fillOpacity > 0)) return true;
                } else {
                    // se não tem options, assume visível
                    return true;
                }
            }
            return false;
        } else {
            // camada única
            const o = leafletLayer.options || {};
            if (o.opacity === 0 && o.fillOpacity === 0) return false;
            return true;
        }
    };

    const isLayerVisibleCombined = (leafletLayer, controlItem) => {
        const onMap = isOnMap(leafletLayer);
        const eyeOpen = isEyeOpenFromControl(controlItem);
        const nonZeroOpacity = hasNonZeroOpacity(leafletLayer);
        return onMap && eyeOpen && nonZeroOpacity;
    };

    // view
    const centerObj = map.getCenter ? map.getCenter() : { lat: null, lng: null };
    const state = {
        view: {
            center: [centerObj.lat, centerObj.lng],
            zoom: map.getZoom ? map.getZoom() : null
        },
        filters: {},    // iremos popular em seguida
        layersOrder: [],
        layers: {
            petalMapCell: {},
            mapCellsPropagationDelay: {},
            mapCellsOoklaDots: {},
            files: {}
        }
    };

    // varrer layer control
    const items = Array.from(document.querySelectorAll('.map-cells-draggable-item'));
    items.forEach(item => {
        const layerAttr = item.getAttribute('layer');
        const techAttr = item.getAttribute('tech');
        const layerNameAttr = item.getAttribute('layerName');

        if (layerAttr === 'newLayer') {
            state.layersOrder.push({ layer: 'newLayer', name: layerNameAttr || null, title: item.getAttribute('layerTitle') || null });
        } else {
            state.layersOrder.push({ layer: layerAttr, tech: techAttr || null });
        }
    });

    // PETAL — para cada tech e cada frequency, coletar visibilidade e style
    for (const tec of mapInstancy.techs) {
        state.layers.petalMapCell[tec] = {};
        const freqs = mapInstancy.frequencies[tec] || {};
        for (const freq of Object.keys(freqs)) {
            const layersArr = (mapInstancy.cells?.[tec]?.[freq]) || [];
            // usar primeiro layer como referência para group (se houver)
            const anyLayer = layersArr.find(l => l) || null;
            const controlItem = findLayerControlItem({ layer: 'petalMapCell', tec });
            const visible = isLayerVisibleCombined(anyLayer, controlItem);
            state.layers.petalMapCell[tec][freq] = {
                visible,
                style: {
                    radius: freqs[freq].radius,
                    color: freqs[freq].color,
                    font: freqs[freq].font
                },
                count: layersArr.length
            };
        }
        // também guardar filtros selecionados no painel para esse tec (se existirem)
        try {
            const ufEl = document.querySelector(`#map-cells-control-panel-select-uf${tec}`);
            const cityEl = document.querySelector(`#map-cells-control-panel-select-cities${tec}`);
            const stationEl = document.querySelector(`#map-cells-control-panel-select-station${tec}`);
            const cellEl = document.querySelector(`#map-cells-control-panel-select-cell${tec}`);
            state.filters[tec] = {
                uf: ufEl ? ufEl.value : null,
                city: cityEl ? cityEl.value : null,
                station: stationEl ? stationEl.value : null,
                cell: cellEl ? cellEl.value : null
            };
        } catch (e) { /* ignore if DOM missing */ }
    }

    // PROPAGATION — para cada tec e cell
    for (const tec of mapInstancy.techs) {
        state.layers.mapCellsPropagationDelay[tec] = {};
        const cellsObj = mapInstancy.propagationDelay?.[tec] || {};
        for (const cellName in cellsObj) {
            const layersArr = cellsObj[cellName] || [];
            const anyLayer = layersArr.find(l => l) || null;
            const controlItem = findLayerControlItem({ layer: 'mapCellsPropagationDelay', tec });
            const visible = isLayerVisibleCombined(anyLayer, controlItem);
            // coletar percentuais (se existirem) e grid size
            const percents = layersArr.map(l => (l && l.options && l.options.percent) ? l.options.percent : null);
            state.layers.mapCellsPropagationDelay[tec][cellName] = {
                visible,
                percents,
                grid: mapInstancy.propagationDelayConsts?.[tec]?.grid || null
            };
        }
    }

    // OOKLA — checar cluster e parâmetros do painel (date, uf, velocities)
    for (const tec of mapInstancy.techs) {
        // only 4G/5G generally, but iteramos por segurança
        const cluster = mapInstancy.ooklaDots?.[tec] || null;
        const controlItem = findLayerControlItem({ layer: 'mapCellsOoklaDots', tec });
        const visible = isLayerVisibleCombined(cluster, controlItem);

        // coletar UF selecionada e datepicker e selected velocities (pela UI)
        let uf = null;
        try {
            const ufSelect = document.querySelector(`#map-cells-ookla-select-uf${tec}`);
            if (ufSelect) uf = ufSelect.value;
        } catch (e) { }
        let dateRange = null;
        try {
            const dr = document.querySelector(`#dateRangePicker${tec}`);
            if (dr) dateRange = dr.value;
        } catch (e) { }
        // velocities: buscar nos subtitles
        const velocities = [];
        try {
            const subtitlesDiv = document.querySelector(`#subtitle-mapCellsOoklaDots${tec}`);
            if (subtitlesDiv) {
                subtitlesDiv.querySelectorAll('.map-cells-subtitle-info').forEach(si => {
                    if (si.getAttribute('selected') === 'true') velocities.push(si.getAttribute('value'));
                });
            }
        } catch (e) { }

        state.layers.mapCellsOoklaDots[tec] = {
            visible,
            uf,
            dateRange,
            velocities
        };
    }

    // FILES (newLayer) - copiar info + visibilidade + ordering metadata
    for (const name in mapInstancy.files) {
        const fileInfo = mapInstancy.files[name].info || {};
        const layerGroup = mapInstancy.layerFiles?.[name] || null;
        const controlItem = findLayerControlItem({ layer: 'newLayer', name });
        const visible = isLayerVisibleCombined(layerGroup, controlItem);

        // clone do info (não mutar original)
        const clonedInfo = JSON.parse(JSON.stringify(fileInfo));
        // adicionar flags operacionais
        clonedInfo.visible = visible;
        clonedInfo.inLayerControl = !!controlItem;

        state.layers.files[name] = clonedInfo;
    }

    const json = JSON.stringify(state);
    
    console.log('map state:', state);
    return state; 
};

const waitForVSData = (selector) => {
    return new Promise(resolve => {
        const interval = setInterval(() => {
            const el = document.querySelector(selector);

            if (el && el.options && el.options.length > 0) {
                clearInterval(interval);
                resolve();
            }
        }, 50);
    });
};

const setVSValue = async (selector, values) => {
    const el = document.querySelector(selector);
    if (!el) return;

    await waitForVSData(selector);
    el.setValue(values);
};

const restoreFilterStep = async (tec, field, values, isLast = false) => {

    if (!isLast) changeAccess = false;
    else changeAccess = true;  // permite disparar callCellData()

    const selector = `#map-cells-control-panel-select-${field}${tec}`;
    await setVSValue(selector, values);
};

const loadInstancy = async (state, mapInstancy) => {
    mapInstancy.map.setView(state.view.center, state.view.zoom);

    mapInstancy.map.eachLayer(layer => {
        if (!layer._url) { // mantém apenas o tileLayer
            map.removeLayer(layer);
        }
    });

    for (const tec of Object.keys(state.filters)) {
        const saved = state.filters[tec];

        if(saved['uf'].length != 0){

            changeAccess = true;
            await restoreFilterStep(tec, "uf", saved.uf);
            await waitForVSData(`#map-cells-control-panel-select-cities${tec}`);
    
            changeAccess = false;
            await restoreFilterStep(tec, "cities", saved.city);
            await waitForVSData(`#map-cells-control-panel-select-station${tec}`);
    
            await restoreFilterStep(tec, "station", saved.station);
            await waitForVSData(`#map-cells-control-panel-select-cell${tec}`);
    
            await restoreFilterStep(tec, "cell", saved.cell);
        }

        changeAccess = true;

    }
};