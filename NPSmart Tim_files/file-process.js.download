const processFile = (contents, delimiters, recordFieldsValues) => {
    contents - contents.slice()
    const delimiterMap = {
        'tab': '\t',
        'colon': ':',
        'space': ' ',
        'semicolon': ';',
        'comma': ','
    };

    const splitLines = (content, delimiters) => {
        let regexPattern = delimiters.map(delimiter => {
            return delimiterMap[delimiter] ? `${delimiterMap[delimiter]}\\s*` : `${delimiter}\\s*`;
        }).join('|');

        const regex = new RegExp(regexPattern);
        return content.split(regex).map(item => {
            if (recordFieldsValues.decimalSeparator && recordFieldsValues.decimalSeparator === true) {
                // Substituir vírgulas por pontos apenas se o decimalSeparator for verdadeiro
                return item.replace(/,/g, '.').trim();
            } else {
                return item.trim();
            }
        });
    };

    if (!contents || contents.length === 0) {
        return {};
    }
    const headerNumber = parseInt(recordFieldsValues.headerNumber) || 0;
    contents = contents.slice(headerNumber)
    const data = contents.map(line => splitLines(line, delimiters));
    let header = data[0] || [];
    let inicializateI = 1;
    if (!recordFieldsValues.firstNames) {
        header = header.map((field, index) => `field${index + 1}`);
        inicializateI = 0;
    }

    header = header.map(field => field.replace(/^['"]|['"]$/g, ''));
    const typeInference = {};

    header.forEach(name => {
        typeInference[name.trim()] = null; // Initialize as string
    });
    for (let i = inicializateI; i < data.length; i++) {
        const row = data[i] || [];

        header.forEach((name, index) => {
            const value = row[index] || '';
            const type = inferType(value);
            if (i == 0) {
            }
            const currentType = typeInference[name.trim()];
            if (type != null) {
                if (currentType === null) {
                    // if (type !== 'string') {
                    typeInference[name.trim()] = type; // Update to float, integer or boolean
                    // }
                } else if (currentType === 'integer' && type === 'float') {
                    typeInference[name.trim()] = 'float'; // Update to float
                } else if (currentType === 'float' && type === 'integer') {
                    typeInference[name.trim()] = 'float'; // Update to float
                } else if (currentType !== type) {
                    typeInference[name.trim()] = 'mixed'; // Mark as mixed
                }
            }

        });
    }

    const sqlTypeMap = {
        string: 'TEXT',
        integer: 'FLOAT',
        float: 'FLOAT',
        datetime: 'DATETIME',
        boolean: 'BOOLEAN',
        mixed: 'TEXT' // Use TEXT for mixed types
    };

    const typeMapping = {};
    for (const column in typeInference) {
        typeMapping[column] = sqlTypeMap[typeInference[column]];
    }

    const jsonData = [];
    for (let i = inicializateI; i < data.length; i++) {
        const obj = {};
        header.forEach((name, index) => {
            obj[name.trim()] = data[i][index] || null; // Set null if no value
        });
        jsonData.push(obj);
    }

    

    return {
        header,
        jsonData,
        types: typeMapping
    };
};

const isDateTime = (value) => {
    // Formato esperado: YYYY-MM-DD HH:MM:SS
    const datetimeRegex = /^\d{4}\/\d{2}\/\d{2} \d{2}:\d{2}:\d{2}(\.\d{1,3})?$/;
    return datetimeRegex.test(value);
};
const inferType = (value) => {
    if (value === '') return null;
    if (!isNaN(value) && Number.isInteger(Number(value))) return 'integer';
    if (!isNaN(value) && !Number.isInteger(Number(value))) return 'float';
    if (value.toLowerCase() === 'true' || value.toLowerCase() === 'false') return 'boolean';
    if (isDateTime(value)) return 'datetime';
    return 'string';
};
const encondingCotent = (contents, encoding) => {
    var buffer = new TextEncoder().encode(contents);
    contents = new TextDecoder(encoding).decode(buffer);
    var lines = contents.split('\n');
    return lines;
}
function objectToCsvRow(obj) {
    const values = Object.values(obj);
    const escapedValues = values.map(value => {
        // Se houver aspas duplas dentro do valor, elas precisam ser escapadas
        if (typeof value === 'string') {
            return `"${value.replace(/"/g, '""')}"`;
        }
        return value;
    });
    return escapedValues.join(',');
}

