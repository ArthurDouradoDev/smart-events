# ==========================================
# SmartEvents - Git Ignore Configuration
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
develop-eggs/
downloads/
eggs/
.eggs/
# lib/ removido: conflitava com frontend/lib/ (Chart.js + Leaflet vendored, devem ser rastreados)
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
.venv-build/
venv/
ENV/
env.bak/
venv.bak/

# --- Database / Dynamic Application Data ---
data/
server_data/
*.db
*.sqlite3

# --- PyInstaller / Executable Builds ---
dist/
build/
installer/prerequisites/*.exe

# --- Testes / artefatos temporários locais ---
.pytest*/
.pytest-cache/
.pytest_cache/
.phase3-pytest-*/
.phase*/
.tmp/

# --- PyInstaller metadata ---
*.manifest
# *.spec removido: main.spec é o spec do PyInstaller e deve ser rastreado

# --- Logs ---
*.log
logs/
err/
*.har

# --- OS / System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs / Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Local Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Node / Frontend Packages ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Configurações locais do agente (não commitar; contém permissões de máquina) ---
.claude/settings.local.json

# --- Espelhos de sites offline (muitos arquivos de assets) ---
docs/references/npsmart/offline_site/
docs/references/npsmart/NPSmart Tim_files/

# --- Arquivos a ser ignorados
untracked/
